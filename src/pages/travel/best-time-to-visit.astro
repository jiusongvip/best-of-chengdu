---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';

const seasons = [
  {
    name: 'Spring (March–May)',
    tag: 'Best season overall',
    temp: '10–27°C · Warming through the season',
    rain: 'Moderate — light showers, mostly in April and May',
    crowds: 'Moderate. Busy during Qingming Festival (early April) and Labor Day (May 1–5).',
    hotelPrice: 'Moderate — book ahead for May holidays.',
    whyGo: 'Chengdu at its most beautiful. Magnolias in March, cherry blossoms in April, roses in May. Pandas are at their most active in the mild weather, tea houses spill onto sidewalks, and the temperature is perfect for walking — light jacket in the morning, t-shirt by afternoon.',
    whatToWear: 'Layers — mornings can be 10°C, afternoons 25°C. Light jacket, long pants, walking shoes, and a compact umbrella for spring showers.',
    events: ['Qingming Festival (early April) — kite flying and green rice balls (青团)', 'Labor Day Holiday (May 1–5) — crowded nationwide, book hotels 2+ weeks ahead'],
    photoTip: 'Cherry blossoms at Qingcheng Mountain in April; magnolias in People\'s Park in March — white blossoms against gray skies.',
  },
  {
    name: 'Summer (June–August)',
    tag: 'Hot & humid · Baby panda season · Best nightlife',
    temp: '22–33°C · High humidity makes it feel 3–5°C hotter',
    rain: 'Heavy — daily afternoon thunderstorms. July is the wettest month (235mm).',
    crowds: 'Very busy. School holidays (July–August) bring domestic family travel.',
    hotelPrice: 'Moderate to high — summer is peak domestic tourism season.',
    whyGo: 'The toughest season for comfort, but with real compensations: August is baby panda season — the nursery fills with newborns. Summer nights are when Chengdu comes alive, with hotpot lines at midnight and street food at its best. Mountain escapes run 8–12°C cooler.',
    whatToWear: 'Quick-dry fabrics (cotton stays damp), sun hat, SPF 50+, insect repellent, and an umbrella that doubles as sun and rain protection.',
    events: ['Dragon Boat Festival (June) — zongzi and dragon boat races', 'Summer school holidays (July–August) — domestic tourism peaks'],
    photoTip: 'Storm clouds over the city at sunset; lotus flowers at Wenshu Monastery in July; baby pandas at 8 AM sharp.',
  },
  {
    name: 'Autumn (September–November)',
    tag: 'Best season overall',
    temp: '10–25°C · Cooling through the season',
    rain: 'Low — the driest season. September may have residual summer rain.',
    crowds: 'Mixed. Golden Week (Oct 1–7) is the busiest week of the year — avoid it. November is gloriously quiet.',
    hotelPrice: 'Very high during Golden Week. Moderate afterward. November is a bargain.',
    whyGo: 'If we had to pick one season: autumn. The humidity drops, ginkgo trees turn brilliant gold, and the light is a photographer\'s dream. This is also the best time for day trips — crisp mountain air and clear views. Hotpot season officially begins.',
    whatToWear: 'September: summer clothes plus a light evening jacket. October: long pants and a light sweater. November: a proper jacket and scarf.',
    events: ['Mid-Autumn Festival (Sep/Oct) — mooncakes and lantern displays', 'Golden Week (Oct 1–7) — AVOID: doubled prices, sold-out trains'],
    photoTip: 'Ginkgo avenues at Daci Temple, Sichuan University, and People\'s Park. Best color: late October to mid-November, 3–5 PM backlight.',
  },
  {
    name: 'Winter (December–February)',
    tag: 'Quiet, gray, atmospheric · Lowest prices',
    temp: '3–12°C · Damp cold that feels 5°C colder than the number',
    rain: 'Low rainfall but persistent gray skies. The famous Chengdu fog settles in for weeks.',
    crowds: 'Very low (except Chinese New Year). Tourist sites are empty.',
    hotelPrice: 'Lowest of the year (except CNY). Luxury hotels drop to ¥700–900/night.',
    whyGo: 'Not postcard-pretty, but underrated: hotpot tastes better in the cold, tea houses feel cozier, and tourist sites are gloriously empty — you can walk through Wuhou Shrine with nobody around. Chinese New Year is a cultural spectacle but brings closures and transport chaos.',
    whatToWear: 'Warm coat, thermal underlayers, wool socks, waterproof shoes. The damp cold penetrates — dress 5°C warmer than the number suggests.',
    events: ['Chinese New Year (late Jan/Feb) — temple fairs and lanterns, but restaurants close 3–7 days', 'Wuhou Shrine Temple Fair — Sichuan performances and folk art during CNY'],
    photoTip: 'Winter fog at Wenshu Monastery; Mount Qingcheng like a classical ink painting; empty Panda Base paths on winter weekdays.',
  },
];

const monthDetails = [
  { month: 'January', temp: '3–9°C', rain: '8mm · 6 rainy days', crowds: 'Very low', rating: '★★★', note: 'Cold and gray. Best for hotpot and uncrowded sites. Lowest hotel prices.' },
  { month: 'February', temp: '5–12°C', rain: '12mm · 8 rainy days', crowds: 'Low (except CNY)', rating: '★★★', note: 'Temple fairs during CNY; lantern festival at month\'s end. Many restaurants closed during CNY week.' },
  { month: 'March', temp: '10–17°C', rain: '20mm · 10 rainy days', crowds: 'Moderate', rating: '★★★★', note: 'Spring arrives, magnolias bloom, pandas active outdoors. An underrated month.' },
  { month: 'April', temp: '15–23°C', rain: '45mm · 14 rainy days', crowds: 'Moderate', rating: '★★★★★', note: 'Cherry blossoms and perfect walking weather. One of the two best months.' },
  { month: 'May', temp: '19–27°C', rain: '85mm · 16 rainy days', crowds: 'Busy (holiday)', rating: '★★★★', note: 'Warm and pleasant, but avoid Labor Day week (May 1–5). Roses in bloom.' },
  { month: 'June', temp: '22–30°C', rain: '110mm · 15 rainy days', crowds: 'Moderate', rating: '★★★', note: 'Heat builds; daily afternoon thunderstorms. Street food season starts.' },
  { month: 'July', temp: '24–33°C', rain: '235mm · 16 rainy days', crowds: 'Busy', rating: '★★', note: 'Hottest, wettest month. Mountains offer an 8–10°C cooler escape.' },
  { month: 'August', temp: '23–32°C', rain: '220mm · 15 rainy days', crowds: 'Busy', rating: '★★★', note: 'Baby pandas appear in the nursery — the one reason to brave August.' },
  { month: 'September', temp: '19–27°C', rain: '120mm · 14 rainy days', crowds: 'Moderate', rating: '★★★★', note: 'Early September is summer; late September is glorious. Humidity finally drops.' },
  { month: 'October', temp: '15–22°C', rain: '40mm · 10 rainy days', crowds: 'High (holiday) then low', rating: '★★★★', note: 'Avoid Golden Week (Oct 1–7). After Oct 8: one of the year\'s best periods.' },
  { month: 'November', temp: '10–16°C', rain: '15mm · 7 rainy days', crowds: 'Low', rating: '★★★★★', note: 'Peak ginkgo season, crisp and uncrowded. Our favorite month — and hotel prices are low.' },
  { month: 'December', temp: '4–10°C', rain: '5mm · 5 rainy days', crowds: 'Very low', rating: '★★★', note: 'Cold, gray, quiet. Hotpot weather peaks. Lowest hotel prices of the year.' },
];

const tempBars = [
  { month: 'Jan', low: 3, high: 9, color: '#90A4AE' },
  { month: 'Feb', low: 5, high: 12, color: '#90A4AE' },
  { month: 'Mar', low: 10, high: 17, color: '#66BB6A' },
  { month: 'Apr', low: 15, high: 23, color: '#43A047' },
  { month: 'May', low: 19, high: 27, color: '#FFA726' },
  { month: 'Jun', low: 22, high: 30, color: '#EF5350' },
  { month: 'Jul', low: 24, high: 33, color: '#E53935' },
  { month: 'Aug', low: 23, high: 32, color: '#EF5350' },
  { month: 'Sep', low: 19, high: 27, color: '#FFA726' },
  { month: 'Oct', low: 15, high: 22, color: '#66BB6A' },
  { month: 'Nov', low: 10, high: 16, color: '#43A047' },
  { month: 'Dec', low: 4, high: 10, color: '#90A4AE' },
];

const travelFocus = [
  { focus: 'Pandas', months: 'March–May & September–November', note: 'Pandas are most active outdoors in mild weather (15–25°C). Baby pandas visible in the nursery August–October. Avoid July–August heat.' },
  { focus: 'Food & Hotpot', months: 'October–March', note: 'Hotpot season runs October–March — the spice warms you in cool weather. Street food peaks in summer (night markets, ice jelly).' },
  { focus: 'Day Trips', months: 'March–May & September–November', note: 'Mountain destinations (Qingcheng, Emei) are best with clear views and comfortable hiking. Leshan and Sanxingdui are fine year-round.' },
  { focus: 'Photography', months: 'April & October–November', note: 'April: cherry blossoms. Late October–November: golden ginkgo — Chengdu\'s most photogenic season. Winter fog is atmospheric.' },
  { focus: 'Budget Travel', months: 'November–February (excluding CNY)', note: 'Lowest hotel prices — luxury hotels drop to ¥700–900/night (40–60% off peak). The trade-off: gray skies and cold damp.' },
  { focus: 'Festivals & Culture', months: 'January/February (CNY) & September/October', note: 'CNY: temple fairs and lanterns, but closures and crowds. Mid-Autumn: mooncakes and family gatherings. Dragon Boat in June.' },
];

const packingBySeason = [
  { season: 'Spring (Mar–May)', items: 'Light jacket, layers (morning/afternoon swing is 15°C), compact umbrella, comfortable walking shoes, sunscreen.' },
  { season: 'Summer (Jun–Aug)', items: 'T-shirts and shorts, sun hat, SPF 50+, insect repellent, umbrella (daily rain), one pair of closed shoes for the Panda Base.' },
  { season: 'Autumn (Sep–Nov)', items: 'September: summer clothes + light jacket. October: sweater. November: warm jacket and scarf. Camera — ginkgo season demands it.' },
  { season: 'Winter (Dec–Feb)', items: 'Warm coat, thermal underlayers, wool socks, waterproof shoes, gloves, scarf, lip balm (indoor heating is very dry).' },
];

const faqs = [
  { q: 'When is the absolute best time to visit Chengdu?', a: 'April and November. April has cherry blossoms, mild temperatures (15–23°C), and active pandas. November has golden ginkgo trees, crisp air, and the lowest crowds outside winter. Both avoid the major Chinese holidays. If you can only pick one: November.' },
  { q: 'When should I avoid visiting Chengdu?', a: 'Three periods: Chinese New Year (late Jan/Feb) — restaurants close for 3–7 days and trains sell out; Golden Week (October 1–7) — crowds overwhelm everything and hotel prices double or triple; and July–August if you hate heat and humidity (33°C with 80% humidity).' },
  { q: 'When is baby panda season?', a: 'Giant pandas give birth in July–August. Cubs are visible in the nursery from mid-August through October. September and October are best — the cubs have their black-and-white fur and are more active. Arrive by 8 AM; the nursery gets crowded by 9:30.' },
  { q: 'Does it snow in Chengdu?', a: 'Almost never in the city — it\'s a once-a-decade event at 500m elevation. The surrounding mountains (Mount Qingcheng, Mount Emei) do get beautiful snow in winter.' },
  { q: 'When are hotel prices lowest?', a: 'December through February (excluding CNY) and November. 4-star hotels run ¥300–400/night and luxury hotels ¥700–900 — 40–60% below peak. Worst value: Golden Week, when prices triple.' },
  { q: 'What\'s the rainy season in Chengdu?', a: 'June through September, peaking in July (235mm) and August (220mm). Rain comes as brief, intense afternoon thunderstorms — it rarely rains all day. Winter is the driest period (5–15mm/month).' },
  { q: 'What\'s the air quality like?', a: 'Worst in winter (December–February) when inversions trap pollutants in the basin; best in summer when rain and wind disperse particulates. Check aqicn.org before outdoor-heavy days. Most visitors find it manageable rather than alarming.' },
  { q: 'How do seasons affect day trips?', a: 'Spring and autumn are ideal for all day trips. Summer: mountains are 8–12°C cooler than the city. Winter: Leshan, Sanxingdui, and Anren are uncrowded; Emei\'s snowy summit is spectacular but needs cold-weather gear.' },
  { q: 'What should I pack regardless of season?', a: 'A VPN installed before you arrive, comfortable walking shoes, an umbrella, a translation app (Pleco or Google Translate offline), and your passport at all times.' },
  { q: 'Is Chengdu\'s weather really as gray as people say?', a: 'Yes — the city averages only 1,000–1,200 hours of sunshine per year (London gets ~1,500). The basin traps cloud cover, especially in winter. Embrace the soft gray light — it\'s flattering for photography and part of the city\'s relaxed character.' },
];

const infoSources = [
  { name: 'Wikipedia — Chengdu', detail: 'Climate, geography & history', url: 'https://en.wikipedia.org/wiki/Chengdu' },
  { name: 'Wikipedia — Sichuan Basin', detail: 'Basin climate & geography', url: 'https://en.wikipedia.org/wiki/Sichuan_Basin' },
  { name: 'AQI China', detail: 'Real-time Chengdu air quality data', url: 'https://aqicn.org/city/chengdu/' },
];

const referenceQuote = {
  text: 'Chengdu is the capital city of the Chinese province of Sichuan. With a population of 20,937,757 at the 2020 census, it is the country\'s fourth most populous city. It is traditionally the hub of Western China.',
  source: 'Wikipedia',
  cite: 'Chengdu — the free encyclopedia',
  url: 'https://en.wikipedia.org/wiki/Chengdu',
};

const schema = {
  '@context': 'https://schema.org',
  'datePublished': '2026-07-29',
  'dateModified': '2026-08-05',
  '@graph': [
    { '@type': 'Article', 'headline': 'Best Time to Visit Chengdu 2026 — Month by Month Guide with Weather, Crowds & Events', 'description': 'Complete seasonal guide: temperature charts, monthly rainfall data, air quality guide, panda activity calendar, festival dates, travel focus matching, packing lists, and honest advice on Chengdu\'s famously gray weather.', 'url': 'https://www.best-of-chengdu.com/travel/best-time-to-visit/', 'datePublished': '2026-07-29', 'dateModified': '2026-08-05', 'author': { '@type': 'Person', 'name': 'Best of Chengdu Team', 'url': 'https://www.best-of-chengdu.com/about/' }, 'publisher': { '@type': 'Organization', 'name': 'Best of Chengdu', 'url': 'https://www.best-of-chengdu.com/' } },
    { '@type': 'BreadcrumbList', 'itemListElement': [
      { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://www.best-of-chengdu.com/' },
      { '@type': 'ListItem', 'position': 2, 'name': 'Travel', 'item': 'https://www.best-of-chengdu.com/travel/' },
      { '@type': 'ListItem', 'position': 3, 'name': 'Best Time to Visit', 'item': 'https://www.best-of-chengdu.com/travel/best-time-to-visit/' },
    ]},
    { '@type': 'Organization', 'name': 'Best of Chengdu', 'url': 'https://www.best-of-chengdu.com/', 'sameAs': [
      'https://github.com/jiusongvip/best-of-chengdu',
      'https://en.wikipedia.org/wiki/Chengdu',
      'https://www.wikidata.org/wiki/Q49802',
    ]},
    { '@type': 'FAQPage', 'mainEntity': faqs.map((faq) => ({ '@type': 'Question', 'name': faq.q, 'acceptedAnswer': { '@type': 'Answer', 'text': faq.a } })) },
  ],
};
---

<BaseLayout schemaJson={JSON.stringify(schema)} title="Best Time to Visit Chengdu: Month Guide" description="When to visit Chengdu: month-by-month weather chart, crowd levels, panda activity, festival dates, packing list, and honest seasonal advice.">
  <Header />

  <main>
    <!-- Hero -->
    <section class="max-w-[860px] mx-auto px-6 pt-20 pb-12">
      <p class="text-xs font-medium tracking-widest uppercase text-accent mb-4">When to Go</p>
      <h1 class="text-4xl md:text-5xl font-display font-semibold tracking-tighter leading-[1.1]">
        Best Time to Visit Chengdu
      </h1>
      <p class="mt-4 text-xs font-medium tracking-widest uppercase text-gray-400">
        Published <time datetime="2026-07-29">July 29, 2026</time> · Updated <time datetime="2026-08-05">August 5, 2026</time> · <a href="/about/" class="text-accent hover:underline">Best of Chengdu Team</a>
      </p>
      <p class="mt-4 text-lg text-gray-500 leading-relaxed max-w-[56ch]">
        April and November are perfect. Spring flowers and golden ginkgo trees in autumn are magical. Summer brings baby pandas but punishing humidity. Winter is gray and glorious in its own way — empty sites and half-price luxury hotels.
      </p>
    </section>

    <!-- Quick Verdict -->
    <section class="max-w-[860px] mx-auto px-6 pb-12">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="p-5 rounded-xl bg-accent/5 border border-accent/10 text-center">
          <span class="block text-[10px] font-medium text-accent uppercase mb-1">Best Overall</span>
          <span class="block text-xl font-bold text-[#1a1a1a]">April & November</span>
          <span class="block text-xs text-gray-500 mt-1">Perfect weather, manageable crowds, most beautiful scenery</span>
        </div>
        <div class="p-5 rounded-xl bg-surface border border-border text-center">
          <span class="block text-[10px] font-medium text-gray-400 uppercase mb-1">Baby Pandas</span>
          <span class="block text-xl font-bold text-[#1a1a1a]">Aug–Oct</span>
          <span class="block text-xs text-gray-500 mt-1">Nursery cubs visible from mid-August</span>
        </div>
        <div class="p-5 rounded-xl bg-surface border border-border text-center">
          <span class="block text-[10px] font-medium text-gray-400 uppercase mb-1">Best Value</span>
          <span class="block text-xl font-bold text-[#1a1a1a]">Nov–Feb</span>
          <span class="block text-xs text-gray-500 mt-1">Lowest hotel prices, no crowds, hotpot season</span>
        </div>
      </div>
    </section>

    <!-- TEMPERATURE BARS -->
    <section class="max-w-[860px] mx-auto px-6 pb-14">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-2">Temperature at a Glance</h2>
      <p class="text-sm text-gray-500 mb-6 max-w-[52ch]">Mild winters and hot, humid summers. The annual range is narrower than Beijing or Shanghai — but humidity amplifies both heat and cold.</p>
      <div class="p-6 rounded-xl border border-border bg-white">
        <div class="space-y-2.5">
          {tempBars.map((t) => (
            <div class="flex items-center gap-3">
              <span class="text-xs font-medium text-gray-400 w-8 text-right">{t.month}</span>
              <div class="flex-1 relative h-5 bg-surface rounded-full overflow-hidden">
                <div class="absolute inset-y-0 rounded-full opacity-30" style={`left:${(t.low / 40) * 100}%; width:${((t.high - t.low) / 40) * 100}%; background-color:${t.color}`}></div>
                <div class="absolute inset-y-0 rounded-full" style={`left:${(t.low / 40) * 100}%; width:${((t.high - t.low) / 40) * 100}%; background-color:${t.color}; opacity:0.7; border:1px solid ${t.color}`}></div>
              </div>
              <span class="text-[10px] text-gray-400 w-16">{t.low}–{t.high}°C</span>
            </div>
          ))}
        </div>
        <div class="flex justify-between mt-4 text-[10px] text-gray-400">
          <span>0°C</span><span>10°C</span><span>20°C</span><span>30°C</span><span>40°C</span>
        </div>
      </div>
    </section>

    <!-- Seasons -->
    {seasons.map((season) => (
      <section class="max-w-[860px] mx-auto px-6 pb-16">
        <div class="p-6 rounded-xl border border-border bg-white">
          <div class="flex items-center gap-2 mb-4">
            <h2 class="text-xl font-display font-semibold tracking-tight text-[#1a1a1a]">{season.name}</h2>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-accent/10 text-accent font-medium">{season.tag}</span>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-5">
            <div class="p-3 rounded-lg bg-surface text-center">
              <span class="block text-[10px] text-gray-400 mb-0.5">Temperature</span>
              <span class="block text-[11px] font-semibold text-[#1a1a1a] leading-tight">{season.temp}</span>
            </div>
            <div class="p-3 rounded-lg bg-surface text-center">
              <span class="block text-[10px] text-gray-400 mb-0.5">Rainfall</span>
              <span class="block text-[11px] font-semibold text-[#1a1a1a] leading-tight">{season.rain}</span>
            </div>
            <div class="p-3 rounded-lg bg-surface text-center">
              <span class="block text-[10px] text-gray-400 mb-0.5">Crowds</span>
              <span class="block text-[11px] font-semibold text-[#1a1a1a] leading-tight">{season.crowds}</span>
            </div>
            <div class="p-3 rounded-lg bg-surface text-center">
              <span class="block text-[10px] text-gray-400 mb-0.5">Hotel Prices</span>
              <span class="block text-[11px] font-semibold text-[#1a1a1a] leading-tight">{season.hotelPrice}</span>
            </div>
          </div>

          <h3 class="text-sm font-semibold text-[#1a1a1a] mb-1.5">What It's Really Like</h3>
          <p class="text-sm text-gray-500 leading-relaxed mb-4">{season.whyGo}</p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <p class="text-xs font-semibold text-[#1a1a1a] uppercase tracking-wide mb-1.5">👕 What to Wear</p>
              <p class="text-xs text-gray-500 leading-relaxed">{season.whatToWear}</p>
            </div>
            <div>
              <p class="text-xs font-semibold text-[#1a1a1a] uppercase tracking-wide mb-1.5">🎉 Events & Festivals</p>
              <ul class="space-y-1">
                {season.events.map((event) => (
                  <li class="text-xs text-gray-500">· {event}</li>
                ))}
              </ul>
            </div>
            <div>
              <p class="text-xs font-semibold text-[#1a1a1a] uppercase tracking-wide mb-1.5">📸 Photo Tip</p>
              <p class="text-xs text-gray-500 leading-relaxed">{season.photoTip}</p>
            </div>
          </div>
        </div>
      </section>
    ))}

    <!-- Monthly Table -->
    <section class="bg-surface py-20">
      <div class="max-w-[860px] mx-auto px-6">
        <h2 class="text-2xl font-display font-semibold tracking-tight mb-2">Month-by-Month Breakdown</h2>
        <p class="text-sm text-gray-500 mb-8 max-w-[52ch]">Detailed weather data, crowd levels, and honest notes for every month. All temperatures are for Chengdu city (500m elevation).</p>
        <div class="overflow-x-auto rounded-xl border border-border bg-white">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="bg-surface/50">
                <th class="text-left py-2.5 pr-3 pl-5 font-medium text-gray-400 text-xs uppercase tracking-wide">Month</th>
                <th class="text-left py-2.5 pr-3 font-medium text-gray-400 text-xs uppercase tracking-wide">Temp</th>
                <th class="text-left py-2.5 pr-3 font-medium text-gray-400 text-xs uppercase tracking-wide">Rain</th>
                <th class="text-left py-2.5 pr-3 font-medium text-gray-400 text-xs uppercase tracking-wide">Crowds</th>
                <th class="text-left py-2.5 pr-3 font-medium text-gray-400 text-xs uppercase tracking-wide">Rating</th>
                <th class="text-left py-2.5 pr-5 font-medium text-gray-400 text-xs uppercase tracking-wide">Notes</th>
              </tr>
            </thead>
            <tbody>
              {monthDetails.map((row) => (
                <tr class="border-b border-border/50 hover:bg-accent/[0.02]">
                  <td class="py-2.5 pr-3 pl-5 font-medium text-[#1a1a1a]">{row.month}</td>
                  <td class="py-2.5 pr-3 text-gray-500 text-xs">{row.temp}</td>
                  <td class="py-2.5 pr-3 text-gray-500 text-xs">{row.rain}</td>
                  <td class="py-2.5 pr-3 text-gray-500 text-xs">{row.crowds}</td>
                  <td class="py-2.5 pr-3">{row.rating}</td>
                  <td class="py-2.5 pr-5 text-xs text-gray-500 leading-relaxed">{row.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- TRAVEL FOCUS -->
    <section class="max-w-[860px] mx-auto px-6 py-20">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-2">Best Time for What You Care About</h2>
      <p class="text-sm text-gray-500 mb-8 max-w-[52ch]">Different travelers, different priorities. Match your interests to the right months.</p>
      <div class="space-y-3">
        {travelFocus.map((tf) => (
          <div class="p-5 rounded-xl border border-border bg-white hover:shadow-sm transition-shadow">
            <div class="flex flex-wrap items-center gap-3 mb-2">
              <h3 class="font-semibold text-[#1a1a1a]">{tf.focus}</h3>
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-accent/10 text-accent font-medium">{tf.months}</span>
            </div>
            <p class="text-sm text-gray-500 leading-relaxed">{tf.note}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Packing by Season -->
    <section class="bg-surface py-20">
      <div class="max-w-[860px] mx-auto px-6">
        <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">What to Pack — By Season</h2>
        <div class="space-y-3">
          {packingBySeason.map((p) => (
            <div class="p-4 rounded-xl border border-border bg-white">
              <span class="text-xs font-semibold text-accent uppercase block mb-1">{p.season}</span>
              <p class="text-xs text-gray-500 leading-relaxed">{p.items}</p>
            </div>
          ))}
        </div>
        <div class="mt-6 p-4 rounded-xl bg-amber-50 border border-amber-100">
          <p class="text-xs text-amber-800 leading-relaxed">
            <strong>🌧️ Chengdu Weather Reality:</strong> The city averages only 1,000–1,200 hours of sunshine per year — less than London. The near-constant cloud cover is the defining feature of Chengdu's climate. Embrace the soft gray light — it's flattering for photography and part of the city's famously relaxed pace of life.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="max-w-[860px] mx-auto px-6 py-20">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-8">Weather & Timing FAQ</h2>
      <div class="space-y-3">
        {faqs.map((faq, i) => (
          <div class="rounded-xl border border-border bg-white overflow-hidden">
            <button
              class="faq-toggle w-full flex items-center justify-between p-5 text-left hover:bg-accent/[0.02] transition-colors"
              data-index={i}
              aria-expanded="false"
            >
              <span class="font-semibold text-[#1a1a1a] pr-4 text-sm">{faq.q}</span>
              <svg class="faq-icon shrink-0 transition-transform duration-200" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-answer hidden px-5 pb-5">
              <p class="text-sm text-gray-500 leading-relaxed">{faq.a}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SOURCES -->
    <section id="sources" class="max-w-[860px] mx-auto px-6 pb-20">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-2">Sources & References</h2>
      <p class="text-sm text-gray-500 mb-6">Authoritative references behind the climate data and facts on this page.</p>
      <blockquote class="border-l-4 border-accent/40 pl-5 py-3 mb-8 text-sm text-gray-600 italic leading-relaxed bg-surface rounded-r-lg">
        <p>{referenceQuote.text}</p>
        <footer class="mt-2 text-xs text-accent not-italic">— <cite><a href={referenceQuote.url} target="_blank" rel="noopener noreferrer" class="underline hover:no-underline">{referenceQuote.source}, {referenceQuote.cite}</a></cite></footer>
      </blockquote>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        {infoSources.map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer" class="group p-3 rounded-lg border border-border bg-white text-center hover:border-accent/30 transition-colors">
            <span class="block text-xs font-semibold text-[#1a1a1a] group-hover:text-accent transition-colors">{s.name}</span>
            <span class="block text-[10px] text-gray-400 mt-0.5">{s.detail}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- CROSSLINKS -->
    <section class="max-w-[860px] mx-auto px-6 pb-24">
      <h2 class="text-xs font-medium tracking-widest uppercase text-gray-400 mb-4">Continue Planning</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <a href="/attractions/day-trips/" class="group p-5 rounded-xl border border-border bg-white hover:border-accent/30 hover:shadow-sm transition-all duration-200">
          <span class="text-lg mb-2 block">🏯</span>
          <h3 class="font-semibold text-sm text-[#1a1a1a] group-hover:text-accent transition-colors">Day Trips →</h3>
          <p class="text-xs text-gray-500 mt-1">8 destinations with seasonal advice.</p>
        </a>
        <a href="/travel/hotels/" class="group p-5 rounded-xl border border-border bg-white hover:border-accent/30 hover:shadow-sm transition-all duration-200">
          <span class="text-lg mb-2 block">🏨</span>
          <h3 class="font-semibold text-sm text-[#1a1a1a] group-hover:text-accent transition-colors">Where to Stay →</h3>
          <p class="text-xs text-gray-500 mt-1">5 neighborhoods & 17 hotel picks.</p>
        </a>
        <a href="/" class="group p-5 rounded-xl border border-border bg-white hover:border-accent/30 hover:shadow-sm transition-all duration-200">
          <span class="text-lg mb-2 block">🏠</span>
          <h3 class="font-semibold text-sm text-[#1a1a1a] group-hover:text-accent transition-colors">Full Chengdu Guide →</h3>
          <p class="text-xs text-gray-500 mt-1">Food, pandas, attractions & complete FAQ.</p>
        </a>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    document.querySelectorAll('.faq-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const answer = btn.nextElementSibling;
        const icon = btn.querySelector('.faq-icon');
        const isOpen = !answer.classList.contains('hidden');
        answer.classList.toggle('hidden');
        icon.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
        btn.setAttribute('aria-expanded', String(!isOpen));
      });
    });
  </script>
</BaseLayout>
