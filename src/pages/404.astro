---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
---

<BaseLayout noindex={true} title="Page Not Found" description="The page you are looking for does not exist.">
  <Header />

  <main class="flex-1 flex items-center justify-center min-h-[60vh]">
    <div class="text-center px-6 py-24">
      <p class="text-6xl font-display font-semibold text-accent mb-4">404</p>
      <h1 class="text-2xl md:text-3xl font-display font-semibold text-[#1a1a1a] mb-4">Page Not Found</h1>
      <p class="text-gray-500 max-w-[48ch] mx-auto mb-8">The page you're looking for doesn't exist or has been moved.</p>
      <a href="/" class="inline-flex items-center gap-2 bg-accent text-white px-7 py-3.5 rounded-full text-sm font-medium hover:bg-accent-dark transition-colors duration-150">
        Back to Homepage
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
