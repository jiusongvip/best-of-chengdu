---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';

const schema = {
  '@context': 'https://schema.org',
  'datePublished': '2026-07-29',
  'dateModified': '2026-07-29',
  '@graph': [{'@type': 'Article', 'headline': 'Chengdu Nightlife Guide', 'description': 'Craft cocktails, live music, and late-night skewer joints.', 'url': 'https://best-of-chengdu.com/experiences/nightlife', 'author': {'@type': 'Organization', 'name': 'Best of Chengdu'}}, {'@type': 'BreadcrumbList', 'itemListElement': [{'@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://best-of-chengdu.com/'}, {'@type': 'ListItem', 'position': 2, 'name': 'Experiences', 'item': 'https://best-of-chengdu.com/experiences'}, {'@type': 'ListItem', 'position': 3, 'name': 'Nightlife', 'item': 'https://best-of-chengdu.com/experiences/nightlife'}]}],
};
---

<BaseLayout schemaJson={JSON.stringify(schema)} title="Chengdu Nightlife Guide" description="Craft cocktails, live music, and late-night skewer joints.">
  <Header />

  <main>
    <section class="max-w-[860px] mx-auto px-6 pt-20 pb-24">
      <h1 class="text-4xl md:text-5xl font-display font-semibold tracking-tighter leading-[1.1]">
        Chengdu Nightlife Guide
      </h1>
      <p class="mt-4 text-lg text-gray-500 leading-relaxed">Chengdu after dark is a different city. The spicy food gets spicier, the tea houses become bars, and the streets fill with the smell of charcoal grills. Here is where to go.</p>
    </section>
    <section class="max-w-[860px] mx-auto px-6 pb-16">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">Best nightlife spots</h2>
      <div class="space-y-4">
        <div class="p-5 rounded-xl border border-border flex gap-4"><span class="shrink-0 w-8 h-8 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">1</span><div><div class="flex items-center gap-2"><h3 class="font-display font-semibold text-[#1a1a1a]">Jiuyanqiao Bar Street</h3><span class="text-xs px-2 py-0.5 rounded-full bg-surface text-gray-500">Riverside</span></div><p class="text-sm text-gray-500 mt-1">Chengdu's classic nightlife strip along the Jinjiang River. Dozens of bars and clubs with river views. Start at a quieter rooftop bar and work your way down. Lively every night.</p></div></div>
        <div class="p-5 rounded-xl border border-border flex gap-4"><span class="shrink-0 w-8 h-8 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">2</span><div><div class="flex items-center gap-2"><h3 class="font-display font-semibold text-[#1a1a1a]">Lan Kwai Fong Chengdu</h3><span class="text-xs px-2 py-0.5 rounded-full bg-surface text-gray-500">Club district</span></div><p class="text-sm text-gray-500 mt-1">A concentrated block of clubs, bars, and late-night restaurants near the city center. More international than Jiuyanqiao. Good for bar-hopping without walking far.</p></div></div>
        <div class="p-5 rounded-xl border border-border flex gap-4"><span class="shrink-0 w-8 h-8 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">3</span><div><div class="flex items-center gap-2"><h3 class="font-display font-semibold text-[#1a1a1a]">Yulin Area</h3><span class="text-xs px-2 py-0.5 rounded-full bg-surface text-gray-500">Local vibe</span></div><p class="text-sm text-gray-500 mt-1">The neighborhood that inspired the famous folk song "Chengdu." Full of low-key craft beer bars, live music venues, and late-night noodle shops. The most authentically local nightlife area.</p></div></div>
        <div class="p-5 rounded-xl border border-border flex gap-4"><span class="shrink-0 w-8 h-8 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">4</span><div><div class="flex items-center gap-2"><h3 class="font-display font-semibold text-[#1a1a1a]">Taikoo Li Rooftops</h3><span class="text-xs px-2 py-0.5 rounded-full bg-surface text-gray-500">Upscale</span></div><p class="text-sm text-gray-500 mt-1">The swanky end of Chengdu nightlife. Rooftop bars at The Temple House and Niccolo Hotel offer craft cocktails with views of the Daci Temple and the IFS panda. Dress well.</p></div></div>
    </section>
    <section class="bg-surface py-20">
      <div class="max-w-[860px] mx-auto px-6">
        <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">Late-night eats</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-xl bg-white border border-border"><h3 class="font-semibold text-[#1a1a1a]">Late-night skewers (shaokao)</h3><p class="text-sm text-gray-500 mt-1">The essential Chengdu post-drinking ritual. Grilled skewers of meat, vegetables, and tofu, brushed with chili oil and cumin. Look for the smoke rising from street corners after 10pm.</p></div>
          <div class="p-5 rounded-xl bg-white border border-border"><h3 class="font-semibold text-[#1a1a1a]">Night noodle shops</h3><p class="text-sm text-gray-500 mt-1">Small shops that open exclusively from 9pm to 4am, serving bowls of dan dan noodles and wontons to the post-bar crowd. The best ones have no English sign and a line.</p></div>
          <div class="p-5 rounded-xl bg-white border border-border"><h3 class="font-semibold text-[#1a1a1a]">24-hour hotpot</h3><p class="text-sm text-gray-500 mt-1">Some hotpot chains stay open all night. There is something magical about eating bubbling mala broth at 3am while the city sleeps around you.</p></div>
          <div class="p-5 rounded-xl bg-white border border-border"><h3 class="font-semibold text-[#1a1a1a]">Budget</h3><p class="text-sm text-gray-500 mt-1">Bar drinks: 30-60 RMB for a local beer, 60-120 RMB for a cocktail. Late-night skewers: 30-50 RMB per person. Club entry: free to 100 RMB depending on the night.</p></div>
        </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
