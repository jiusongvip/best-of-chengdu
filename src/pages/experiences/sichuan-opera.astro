---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';

const schema = {
  '@context': 'https://schema.org',
  'datePublished': '2026-07-29',
  'dateModified': '2026-07-29',
  '@graph': [{'@type': 'Article', 'headline': 'Sichuan Opera in Chengdu', 'description': 'Face-changing, fire-spitting, and centuries of theatrical tradition.', 'url': 'https://best-of-chengdu.com/experiences/sichuan-opera', 'author': {'@type': 'Organization', 'name': 'Best of Chengdu'}}, {'@type': 'BreadcrumbList', 'itemListElement': [{'@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://best-of-chengdu.com/'}, {'@type': 'ListItem', 'position': 2, 'name': 'Experiences', 'item': 'https://best-of-chengdu.com/experiences'}, {'@type': 'ListItem', 'position': 3, 'name': 'Sichuan Opera', 'item': 'https://best-of-chengdu.com/experiences/sichuan-opera'}]}],
};
---

<BaseLayout schemaJson={JSON.stringify(schema)} title="Sichuan Opera in Chengdu" description="Face-changing, fire-spitting, and centuries of theatrical tradition.">
  <Header />

  <main>
    <section class="max-w-[860px] mx-auto px-6 pt-20 pb-24">
      <h1 class="text-4xl md:text-5xl font-display font-semibold tracking-tighter leading-[1.1]">
        Sichuan Opera in Chengdu
      </h1>
      <p class="mt-4 text-lg text-gray-500 leading-relaxed">Bian lian, or face-changing, is a spellbinding Sichuan art form in which performers switch vividly painted masks in the blink of an eye. Here is where to see it in Chengdu.</p>
    </section>
    <section class="max-w-[860px] mx-auto px-6 pb-16">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">Where to watch Sichuan opera</h2>
      <div class="space-y-4">
        <div class="p-5 rounded-xl border border-border flex gap-4"><span class="shrink-0 w-8 h-8 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">1</span><div><div class="flex items-center gap-2"><h3 class="font-display font-semibold text-[#1a1a1a]">Shufeng Yayun</h3><span class="text-xs px-2 py-0.5 rounded-full bg-surface text-gray-500">Best overall</span></div><p class="text-sm text-gray-500 mt-1">Inside Culture Park, this is the most popular venue for good reason. The show includes face-changing, fire-spitting, hand shadows, and traditional music. Arrive early for a pre-show tea. Tickets from 120 RMB.</p></div></div>
        <div class="p-5 rounded-xl border border-border flex gap-4"><span class="shrink-0 w-8 h-8 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">2</span><div><div class="flex items-center gap-2"><h3 class="font-display font-semibold text-[#1a1a1a]">Jinjiang Theater</h3><span class="text-xs px-2 py-0.5 rounded-full bg-surface text-gray-500">Intimate</span></div><p class="text-sm text-gray-500 mt-1">A smaller, more traditional venue near the Jinjiang River. The audience sits close to the stage, which makes the face-changing reveals even more impressive. Tickets around 100 RMB.</p></div></div>
        <div class="p-5 rounded-xl border border-border flex gap-4"><span class="shrink-0 w-8 h-8 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">3</span><div><div class="flex items-center gap-2"><h3 class="font-display font-semibold text-[#1a1a1a]">Shu Feng Ya Yun</h3><span class="text-xs px-2 py-0.5 rounded-full bg-surface text-gray-500">Historic</span></div><p class="text-sm text-gray-500 mt-1">Housed in a historic building near Kuanzhai Alley. The courtyard setting adds atmosphere, and the show includes a wider range of Sichuan folk arts alongside the opera. 80-150 RMB.</p></div></div>
    </section>
    <section class="bg-surface py-20">
      <div class="max-w-[860px] mx-auto px-6">
        <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">What to know</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-xl bg-white border border-border"><h3 class="font-semibold text-[#1a1a1a]">The art of bian lian</h3><p class="text-sm text-gray-500 mt-1">Performers switch masks in fractions of a second using silk masks layered on the face. The technique is a closely guarded secret passed down through master-apprentice relationships.</p></div>
          <div class="p-5 rounded-xl bg-white border border-border"><h3 class="font-semibold text-[#1a1a1a]">What else is performed</h3><p class="text-sm text-gray-500 mt-1">Beyond face-changing, expect fire-spitting, acrobatics, shadow puppetry, and erhu (two-stringed fiddle) solos. Most shows run 60-90 minutes with English subtitles.</p></div>
          <div class="p-5 rounded-xl bg-white border border-border"><h3 class="font-semibold text-[#1a1a1a]">Best seats</h3><p class="text-sm text-gray-500 mt-1">Front-center seats give the best view of the face-changing. Some venues offer VIP packages with tea service and closer seating for 200-300 RMB.</p></div>
          <div class="p-5 rounded-xl bg-white border border-border"><h3 class="font-semibold text-[#1a1a1a]">When to go</h3><p class="text-sm text-gray-500 mt-1">Most theaters have nightly shows starting around 8pm. Book tickets same-day at the venue or through your hotel concierge. Weekends sell out, so book ahead.</p></div>
        </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
