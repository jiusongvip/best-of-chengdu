<BaseLayout
  schemaJson={JSON.stringify(schema)}
  title="Chengdu Guide: Food, Pandas & Tips"
  description="Chengdu travel guide updated Aug 2026. 8 must-try dishes with restaurant names, panda base comparison, month-by-month weather, and honest first-timer advice."
>
  <Header />

  <main>
    <!-- ===== HERO ===== -->
    <section class="relative">
      <div class="absolute inset-0 bg-surface"></div>
      <div class="max-w-[1200px] mx-auto relative">
        <div class="grid md:grid-cols-2 gap-0 min-h-[520px] md:min-h-[640px] items-stretch">
          <div class="flex flex-col justify-center px-6 md:px-12 py-20 md:py-0">
            <p class="text-xs font-medium tracking-widest uppercase text-accent mb-4">Updated August 2026 · Our team explored Chengdu in person</p>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-semibold tracking-tighter leading-[1.05] text-[#1a1a1a] max-w-[14ch]">
              Best of Chengdu <span class="text-accent">2026</span>
            </h1>
            <p class="hero-subtitle mt-5 text-base md:text-lg text-gray-500 leading-relaxed max-w-[48ch]">
              Plan an unforgettable trip to China's food capital — where to eat, which panda base to choose, what to expect, and the mistakes to avoid.
            </p>
            <p class="mt-4 text-xs text-gray-400 flex flex-wrap items-center gap-2">
              By <a href="/about/" class="font-medium text-accent hover:text-accent-dark transition-colors">Best of Chengdu Team</a>
              <span aria-hidden="true">·</span>
              <span>Published <time datetime="2026-07-29">July 29, 2026</time></span>
              <span aria-hidden="true">·</span>
              <span>Updated <time datetime="2026-08-05">Aug 5, 2026</time></span>
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="#food" class="inline-flex items-center gap-2 bg-accent text-white px-7 py-3.5 rounded-full text-sm font-medium hover:bg-accent-dark transition-colors duration-150">
                What to eat
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
              <a href="#attractions" class="inline-flex items-center gap-2 border border-border text-gray-700 px-7 py-3.5 rounded-full text-sm font-medium hover:border-accent/30 hover:text-accent transition-colors duration-150">
                See attractions
              </a>
              <a href="#mistakes" class="inline-flex items-center gap-2 border border-border text-gray-700 px-7 py-3.5 rounded-full text-sm font-medium hover:border-accent/30 hover:text-accent transition-colors duration-150">
                Avoid mistakes
              </a>
            </div>
          </div>
          <div class="relative overflow-hidden min-h-[300px] md:min-h-0">
            <picture>
              <source media="(max-width: 767px)" srcset="/images/hero-m.webp" width="768" height="592" />
              <img
                src="/images/hero-d.webp"
                alt="Traditional red lanterns along a Chengdu street with Sichuan-style architecture"
                class="absolute inset-0 w-full h-full object-cover"
                loading="eager"
                fetchpriority="high"
                width="1100"
                height="1210"
              />
            </picture>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== STICKY SECONDARY NAV ===== -->
    <nav id="subnav" class="sticky top-16 z-40 bg-white/90 backdrop-blur-md border-b border-border overflow-x-auto">
      <div class="max-w-[1200px] mx-auto px-6 flex items-center gap-1 py-2 text-xs font-medium whitespace-nowrap">
