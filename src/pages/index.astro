const mustTryDishes = [
  { name: 'Mapo Tofu (麻婆豆腐)', where: 'Chen Mapo Tofu (陈麻婆豆腐) — the original since 1862.', desc: 'Silky cubes of tofu swimming in a blood-red chili-bean sauce, numbing with Sichuan peppercorns, topped with minced pork. The dish that defines the entire Sichuan canon.' },
  { name: 'Kung Pao Chicken (宫保鸡丁)', where: 'Any decent Sichuan restaurant. Piao Xiang (飘香) near Kuanzhai Alley does a textbook version.', desc: 'Tender chicken thigh, golden peanuts, and dried chilies in a glossy sweet-savory-tingly sauce. Nothing — absolutely nothing — like the gloopy takeout version you know.' },
  { name: 'Dan Dan Noodles (担担面)', where: 'Street stalls near Jinli or the noodle shops along Wenshuyuan Street. Look for the longest queue.', desc: 'A bowl of wheat noodles draped in sesame paste, chili oil, soy sauce, and minced pork. Costs about 10 RMB. A humble street snack elevated to art — the single dish that sums up Chengdu.' },
  { name: 'Twice-Cooked Pork (回锅肉)', where: 'Family-run Sichuan restaurants — order it anywhere. Yulin neighborhood has excellent neighborhood joints.', desc: 'Pork belly first simmered, then sliced and wok-fried at violent heat with fermented black beans, leeks, and doubanjiang. Smoky, salty, slightly sweet. The comfort food of Sichuan.' },
  { name: 'Chengdu Hotpot (火锅)', where: 'Shu Daxia (蜀大侠) for theatrics. Huangcheng Laoma (皇城老妈) for tradition. Xiaolongkan (小龙坎) for the real local experience.', desc: 'A cauldron of bubbling chili broth in the center of the table. You cook thinly sliced meats, vegetables, and tofu yourself. The ritual starts with sesame oil dip, ends with cold beer. Expect to wait in line.' },
  { name: 'Fuqi Feipian (夫妻肺片)', where: 'Husband-and-Wife Lung Slices shop (夫妻肺片总店) near Chunxi Road — the inventors.', desc: 'Despite the name, no lungs. Thinly sliced beef, tripe, and tendon in a fiery dressing of chili oil, Sichuan pepper, and sesame. Invented by a Chengdu couple in the 1930s. Surprisingly addictive.' },
  { name: 'Zhong Dumplings (钟水饺)', where: 'Zhong Dumplings original shop (钟水饺) on Tidu Street. Open since 1893.', desc: 'Plump pork dumplings in a puddle of sweet soy, garlic paste, and chili oil. Simple ingredients, perfect balance. A Chengdu icon since the Qing dynasty — locals eat these standing up at the counter.' },
  { name: 'Lai Tangyuan (赖汤圆)', where: 'Lai Tangyuan (赖汤圆) near Jinli. The original storefront from 1894.', desc: 'Glutinous rice balls filled with black sesame paste, floating in sweet osmanthus soup. The dessert that locals order after a punishing hotpot. More than a century old and still perfect.' },
];

