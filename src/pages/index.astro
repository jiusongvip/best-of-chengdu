    <section id="vs-chongqing" class="max-w-[1200px] mx-auto px-6 py-20 md:py-28">
      <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight mb-2 reveal">Chengdu vs Chongqing — Which Should You Visit?</h2>
      <p class="text-gray-500 text-lg max-w-[52ch] mb-10 reveal">Two Sichuan-cuisine mega-cities, 1.5 hours apart by train.</p>
      <div class="overflow-x-auto reveal">
        <table class="w-full max-w-[860px] text-sm border-collapse">
          <thead>
            <tr class="border-b border-border">
              <th class="text-left py-3 pr-4 font-medium text-gray-400 text-xs uppercase tracking-wide w-[18%]"></th>
              <th class="text-left py-3 pr-4 font-semibold text-[#1a1a1a] w-[41%]">Chengdu 成都</th>
              <th class="text-left py-3 pr-4 font-semibold text-[#1a1a1a] w-[41%]">Chongqing 重庆</th>
            </tr>
          </thead>
          <tbody>
            {chengduVsChongqing.map((row) => (
              <tr class="border-b border-border/50">
                <td class="py-3 pr-4 font-medium text-[#1a1a1a]">{row.aspect}</td>
                <td class="py-3 pr-4 text-gray-500 leading-relaxed">{row.chengdu}</td>
                <td class="py-3 pr-4 text-gray-500 leading-relaxed">{row.chongqing}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Chongqing image -->
      <div class="mt-10 mb-8 reveal max-w-[860px]">
        <img
          src="/images/chongqing-hongyadong.webp"
          alt="Hongyadong complex in Chongqing at night — multi-level traditional architecture illuminated along the Jialing River, a stunning contrast to Chengdu's low-rise skyline"
          class="w-full rounded-2xl object-cover max-h-[420px]"
          loading="lazy"
          width="1200"
          height="600"
        />
      </div>

      <p class="text-sm text-gray-500 mt-4 reveal max-w-[860px]"><span class="font-medium text-[#1a1a1a]">Best plan:</span> Spend 2–3 days in each — start in Chengdu for food and pandas, then the 1.5-hour high-speed train (¥150) to Chongqing for an urban adventure. They complement each other perfectly.</p>
    </section>

    <!-- ===== FIRST-TIMER MISTAKES ===== -->
    <section id="mistakes" class="bg-surface py-20 md:py-28">
      <div class="max-w-[1200px] mx-auto px-6">
        <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight mb-2 reveal">6 Mistakes First-Timers Make in Chengdu</h2>
        <p class="text-gray-500 text-lg max-w-[52ch] mb-10 reveal">Learn from other travelers' missteps. Get these right and your trip is already 80% better.</p>
        <div class="space-y-3 max-w-[860px] reveal">
          {firstTimerMistakes.map((item) => (
            <div class="p-5 rounded-xl border border-border bg-white hover:border-accent/20 transition-colors duration-200">
              <div class="flex items-start gap-3">
                <span class="shrink-0 mt-0.5 text-base">⚠️</span>
                <div class="flex-1 min-w-0">
                  <p class="font-semibold text-sm text-[#1a1a1a] mb-1">{item.mistake}</p>
                  <p class="text-sm text-gray-500 leading-relaxed"><span class="font-medium text-accent">Fix:</span> {item.fix}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== BEST PHOTO SPOTS ===== -->
    <section id="photos" class="max-w-[1200px] mx-auto px-6 py-20 md:py-28">
      <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight mb-2 reveal">Best Photo Spots in Chengdu</h2>
      <p class="text-gray-500 text-lg max-w-[52ch] mb-10 reveal">Six locations worth your camera.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 reveal">
        {photoSpots.map((spot) => (
          <div class="rounded-xl border border-border bg-white hover:border-accent/20 hover:shadow-md transition-all duration-200 flex flex-col overflow-hidden">
            <img
              src={spot.img}
              alt={spot.alt}
              class="w-full h-48 object-cover"
              loading="lazy"
              width="600"
              height="400"
            />
            <div class="p-5 flex flex-col flex-1">
              <h3 class="font-display font-semibold text-base text-[#1a1a1a] mb-1.5">{spot.name}</h3>
              <p class="text-sm text-gray-500 leading-relaxed flex-1 mb-3">{spot.desc}</p>
              <span class="text-[11px] font-medium text-accent bg-accent/5 px-2 py-1 rounded-full self-start">🕐 {spot.tip}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== WHAT TRAVELERS SAY ===== -->
    <section class="bg-surface py-20 md:py-28">
      <div class="max-w-[1200px] mx-auto px-6">
        <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight mb-2 reveal">What Travelers Say About Chengdu</h2>
        <p class="text-gray-500 text-lg max-w-[52ch] mb-10 reveal">Real themes from hundreds of traveler reviews.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-[900px] reveal">
          {travelerReviews.map((review) => (
            <figure class="p-5 rounded-xl border border-border bg-white">
              <blockquote class="text-sm text-gray-600 leading-relaxed italic mb-3">"{review.quote}"</blockquote>
              <figcaption class="flex items-center gap-2">
                <span class="text-[10px] px-2 py-0.5 rounded-full bg-accent/10 text-accent font-medium">{review.theme}</span>
                <cite class="text-[10px] text-gray-400 not-italic">— {review.source}</cite>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== HONEST EXPECTATIONS ===== -->
    <section id="expect" class="max-w-[1200px] mx-auto px-6 py-20 md:py-28">
      <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight mb-2 reveal">What to Really Expect</h2>
      <p class="text-gray-500 text-lg max-w-[52ch] mb-10 reveal">Things most guidebooks skip — better to know before you go.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-[860px] reveal">
        {honestExpectations.map((item) => (
          <div class="p-5 rounded-xl border border-border bg-white">
            <h3 class="font-display font-semibold text-base text-[#1a1a1a] mb-1.5">{item.title}</h3>
            <p class="text-sm text-gray-500 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== PACKING CHECKLIST ===== -->
    <section class="bg-surface py-20 md:py-28">
      <div class="max-w-[1200px] mx-auto px-6">
        <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight mb-2 reveal">What to Pack for Chengdu</h2>
        <p class="text-gray-500 text-lg max-w-[52ch] mb-10 reveal">Eight things that separate a smooth trip from a stressful one.</p>
        <div class="space-y-3 max-w-[720px] reveal">
          {packingChecklist.map((item) => (
            <div class="flex items-start gap-4 p-4 rounded-xl border border-border bg-white hover:border-accent/20 transition-colors duration-200">
              <span class="shrink-0 text-[10px] px-2 py-0.5 rounded-full bg-accent/10 text-accent font-bold mt-0.5">{item.tag}</span>
              <div>
                <span class="font-semibold text-sm text-[#1a1a1a]">{item.item}</span>
                <p class="text-xs text-gray-500 mt-0.5 leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== FAQ (accordion) ===== -->
    <section id="faq" class="max-w-[1200px] mx-auto px-6 py-20 md:py-28">
      <div class="max-w-[860px] mx-auto">
        <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight mb-2 reveal">Frequently Asked Questions</h2>
        <p class="text-gray-500 text-lg mb-10 reveal">Every question travelers ask before visiting.</p>
        <div class="space-y-3 reveal" id="faq-list">
          {faqs.map((faq, i) => (
            <div class="rounded-xl border border-border bg-white overflow-hidden">
              <button
                class="faq-toggle w-full flex items-center justify-between p-5 text-left hover:bg-accent/[0.02] transition-colors"
                data-index={i}
                aria-expanded="false"
              >
                <span class="font-semibold text-[#1a1a1a] pr-4">{faq.q}</span>
                <svg class="faq-icon shrink-0 transition-transform duration-200" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
              </button>
              <div class="faq-answer hidden px-5 pb-5">
                <p class="text-sm text-gray-500 leading-relaxed">{faq.a}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== SOURCES & REFERENCES ===== -->
    <section id="sources" class="max-w-[860px] mx-auto px-6 py-12 md:py-16">
      <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight mb-2 reveal">Sources & References</h2>
      <p class="text-gray-500 text-lg mb-8 reveal max-w-[52ch]">Authoritative references behind the facts, prices, and history on this page — so you can verify everything yourself.</p>
      <blockquote class="border-l-4 border-accent/40 pl-5 py-3 mb-8 text-sm text-gray-600 italic leading-relaxed bg-surface rounded-r-lg reveal">
        <p>{referenceQuote.text}</p>
        <footer class="mt-2 text-xs text-accent not-italic">— <cite><a href={referenceQuote.url} target="_blank" rel="noopener noreferrer" class="underline hover:no-underline">{referenceQuote.source}, {referenceQuote.cite}</a></cite></footer>
      </blockquote>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 reveal">
        {infoSources.map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer" class="group p-3 rounded-lg border border-border bg-white text-center hover:border-accent/30 transition-colors">
            <span class="block text-xs font-semibold text-[#1a1a1a] group-hover:text-accent transition-colors">{s.name}</span>
            <span class="block text-[10px] text-gray-400 mt-0.5">{s.detail}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- ===== E-E-A-T / TRUST ===== -->
    <section class="max-w-[860px] mx-auto px-6 pb-12 md:pb-16">
      <div class="p-6 rounded-xl border border-border bg-white">
        <div class="flex items-start gap-3">
          <div class="shrink-0 w-10 h-10 rounded-full bg-accent/10 text-accent flex items-center justify-center text-sm font-bold">BC</div>
          <div>
            <h2 class="font-display font-semibold text-lg text-[#1a1a1a] mb-2">About This Guide</h2>
            <p class="text-sm text-gray-500 leading-relaxed">
              Best of Chengdu is independently researched and regularly updated by the <a href="/about/" class="text-accent hover:text-accent-dark transition-colors">Best of Chengdu Team</a> — editors based in Chengdu, Sichuan.
              We eat at the restaurants we recommend, visit the attractions we describe, and test the itineraries ourselves.
              This page was last updated by our food editor on <strong class="text-[#1a1a1a]">August 5, 2026</strong>.
              We are <strong class="text-[#1a1a1a]">not affiliated</strong> with any government tourism organization, restaurant, or attraction.
              If you spot outdated info or have a tip to share, please <a href="mailto:hello@best-of-chengdu.com" class="text-accent hover:text-accent-dark transition-colors">tell us</a> — this guide gets better because of readers like you.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== NEWSLETTER CTA ===== -->
    <section class="max-w-[1200px] mx-auto px-6 pb-24 md:pb-32">
      <div class="bg-accent rounded-2xl p-10 md:p-16 text-center">
        <h2 class="text-3xl md:text-4xl font-display font-semibold tracking-tight text-white mb-4">Get the inside scoop</h2>
        <p class="text-white/80 text-lg max-w-[48ch] mx-auto mb-8">New restaurant openings, seasonal food guides, and local tips — delivered when it matters.</p>
        <form class="flex gap-3 max-w-md mx-auto" onsubmit="event.preventDefault()">
          <input type="email" placeholder="Your email address" class="flex-1 px-5 py-3.5 rounded-full text-sm bg-white/15 border border-white/20 text-white placeholder:text-white/50 focus:outline-none focus:border-white/40 transition-colors" />
          <button type="submit" class="px-7 py-3.5 rounded-full bg-white text-accent text-sm font-semibold hover:bg-white/90 transition-colors duration-150 shrink-0">Subscribe</button>
        </form>
      </div>
    </section>
  </main>

  <Footer />

  <!-- FAQ accordion -->
  <script>
    document.querySelectorAll('.faq-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const answer = btn.nextElementSibling;
        const icon = btn.querySelector('.faq-icon');
        const isOpen = !answer.classList.contains('hidden');
        answer.classList.toggle('hidden');
        icon.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
        btn.setAttribute('aria-expanded', String(!isOpen));
      });
    });
  </script>
</BaseLayout>
