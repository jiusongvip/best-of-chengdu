const topAttractions = [
  { name: 'Chengdu Research Base of Giant Panda Breeding', tag: 'Unmissable', price: 'CNY 55 · Metro Line 3 · 7:30 AM–6 PM', desc: 'The single best place on earth to see giant pandas. Over 200 pandas in a sprawling park. The nursery has baby pandas year-round. Arrive before 8 AM — pandas eat breakfast and climb, then nap through midday.' },
  { name: 'Jinli Ancient Street (锦里)', tag: 'Must-see', price: 'Free · Walk from Wuhou Shrine · Best at dusk', desc: 'Red lanterns swaying over cobblestone lanes. Street-food stalls, Sichuan embroidery shops, and tea houses along a restored Qing-dynasty street. Go at sunset for the lanterns, stay for the street snacks.' },
  { name: 'Kuanzhai Alley (宽窄巷子)', tag: 'Must-see', price: 'Free · Metro Line 4 (Kuanzhai Xiangzi Station)', desc: 'Three parallel Qing-dynasty alleys — Kuan (wide), Zhai (narrow), and Jing (well). Courtyard restaurants, boutique shops, and tea houses hidden behind carved wooden doors. Tourist-central, but worth it.' },
  { name: 'People\'s Park (人民公园)', tag: 'Authentic', price: 'Free · Metro Line 2 (People\'s Park Station)', desc: 'The living, breathing heart of Chengdu. Old men play mahjong under ginkgo trees. Ladies sing karaoke on portable speakers. Couples post personal ads on Love Lane. Sit at Heming Tea House, order jasmine tea, and watch the city be itself.' },
  { name: 'Wuhou Shrine (武侯祠)', tag: 'Recommended', price: 'CNY 60 · Next to Jinli Street', desc: 'A serene temple complex honoring Zhuge Liang, the legendary Three Kingdoms strategist. Ancient cypress trees, vermilion walls, and carved stone tablets. The famous red-wall corridor is a photographer\'s dream.' },
  { name: 'Wenshu Monastery (文殊院)', tag: 'Recommended', price: 'Free · Metro Line 1 (Wenshu Monastery Station)', desc: 'Chengdu\'s best-preserved Buddhist temple, built during the Tang Dynasty. Home to 80 monks, 300+ Buddha statues, and a vegetarian restaurant that even meat-eaters love. The tea house in the rear garden is pure tranquility.' },
  { name: 'Leshan Giant Buddha (乐山大佛)', tag: 'Day Trip', price: 'CNY 80 · 2 h by train from Chengdu South Station', desc: 'A 71-meter Buddha carved into a red sandstone cliff in the 8th century — the largest stone Buddha on earth. Walk the cliffside path from head to toe. The scale is disorienting in person.' },
  { name: 'Mount Qingcheng (青城山)', tag: 'Day Trip', price: 'CNY 90 · 30 min by train from Lidui Park Station', desc: 'A misty Taoist mountain and UNESCO World Heritage site. Ancient temples tucked into forested slopes, stone staircases disappearing into fog. One of Taoism\'s birthplaces. Front mountain is paved; back mountain is wild.' },
];

