---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';

const quickFacts = [
  { label: 'Population', value: '21 million (metro)' },
  { label: 'Airports', value: 'CTU (Shuangliu) · TFU (Tianfu)' },
  { label: 'Best Time', value: 'Mar–May · Sep–Nov' },
  { label: 'Language', value: 'Mandarin (Southwestern dialect)' },
  { label: 'Currency', value: 'Renminbi (¥ / CNY)' },
  { label: 'Time Zone', value: 'GMT+8 (China Standard)' },
  { label: 'UNESCO', value: 'City of Gastronomy (2010)' },
  { label: 'Founded', value: '221 BC (Qin Dynasty)' },
];

const mustTryDishes = [
  { name: 'Mapo Tofu (麻婆豆腐)', where: 'Chen Mapo Tofu (陈麻婆豆腐) — the original since 1862.', desc: 'Silky tofu in chili-bean sauce, numbing with Sichuan peppercorns. Defines the Sichuan canon.' },
  { name: 'Kung Pao Chicken (宫保鸡丁)', where: 'Piao Xiang (飘香) near Kuanzhai Alley does a textbook version.', desc: 'Tender chicken, peanuts, and dried chilies in a sweet-savory-tingly sauce.' },
  { name: 'Dan Dan Noodles (担担面)', where: 'Street stalls near Jinli or along Wenshuyuan Street.', desc: 'Wheat noodles in sesame paste, chili oil, and minced pork — about 10 RMB.' },
  { name: 'Twice-Cooked Pork (回锅肉)', where: 'Family-run Sichuan restaurants in the Yulin neighborhood.', desc: 'Pork belly wok-fried with fermented black beans, leeks, and doubanjiang.' },
  { name: 'Chengdu Hotpot (火锅)', where: 'Shu Daxia for theatrics; Huangcheng Laoma for tradition; Xiaolongkan for the local experience.', desc: 'A bubbling chili broth cauldron — you cook sliced meats, vegetables, and tofu yourself.' },
  { name: 'Fuqi Feipian (夫妻肺片)', where: 'The inventors\' shop near Chunxi Road.', desc: 'Sliced beef, tripe, and tendon in chili oil and sesame. Invented in the 1930s; no lungs.' },
  { name: 'Zhong Dumplings (钟水饺)', where: 'Original shop on Tidu Street, open since 1893.', desc: 'Pork dumplings in sweet soy, garlic paste, and chili oil. A Qing-dynasty icon.' },
  { name: 'Lai Tangyuan (赖汤圆)', where: 'The original storefront near Jinli, from 1894.', desc: 'Glutinous rice balls with black sesame paste in sweet osmanthus soup.' },
];

const foodCategories = [
  { label: 'Hotpot Guide', href: '/food/hotpot', desc: 'Where to find Chengdu\'s best bubbling broths, from traditional to modern.' },
  { label: 'Sichuan Restaurants', href: '/food/sichuan-restaurants', desc: 'Fine dining, family-run legends, and hidden courtyard gems.' },
];

const topAttractions = [
  { name: 'Chengdu Research Base of Giant Panda Breeding', tag: 'Unmissable', price: 'CNY 55 · Metro Line 3 · 7:30 AM–6 PM', desc: 'Over 200 pandas in a sprawling park, with a baby nursery. Arrive before 8 AM.' },
  { name: 'Jinli Ancient Street (锦里)', tag: 'Must-see', price: 'Free · Walk from Wuhou Shrine · Best at dusk', desc: 'Red lanterns, street-food stalls, and tea houses along a restored Qing-dynasty street.' },
  { name: 'Kuanzhai Alley (宽窄巷子)', tag: 'Must-see', price: 'Free · Metro Line 4 (Kuanzhai Xiangzi Station)', desc: 'Three parallel Qing-dynasty alleys with courtyard restaurants and tea houses.' },
  { name: 'People\'s Park (人民公园)', tag: 'Authentic', price: 'Free · Metro Line 2 (People\'s Park Station)', desc: 'The living heart of Chengdu — mahjong, karaoke, and Heming Tea House.' },
  { name: 'Wuhou Shrine (武侯祠)', tag: 'Recommended', price: 'CNY 60 · Next to Jinli Street', desc: 'A serene temple honoring Three Kingdoms strategist Zhuge Liang, with the famous red-wall corridor.' },
  { name: 'Wenshu Monastery (文殊院)', tag: 'Recommended', price: 'Free · Metro Line 1 (Wenshu Monastery Station)', desc: 'Chengdu\'s best-preserved Buddhist temple, built in the Tang Dynasty.' },
  { name: 'Leshan Giant Buddha (乐山大佛)', tag: 'Day Trip', price: 'CNY 80 · 2 h by train from Chengdu South Station', desc: 'A 71-meter Buddha carved into a cliff in the 8th century — the largest stone Buddha on earth.' },
  { name: 'Mount Qingcheng (青城山)', tag: 'Day Trip', price: 'CNY 90 · 30 min by train from Lidui Park Station', desc: 'A misty Taoist mountain and UNESCO World Heritage site — one of Taoism\'s birthplaces.' },
];

const pandaBaseComparison = [
  { feature: 'Number of pandas', chengdu: '~200 (largest captive population)', dujiangyan: '~20 (smaller, more intimate)' },
  { feature: 'Crowds', chengdu: 'Very busy, especially mornings', dujiangyan: 'Quiet, relaxed — fraction of the crowds' },
  { feature: 'Volunteer keeper program', chengdu: 'Not available', dujiangyan: 'Yes — CNY 700–900 · Book 1–2 weeks ahead' },
  { feature: 'Baby panda nursery', chengdu: 'Open year-round', dujiangyan: 'Seasonal — not guaranteed' },
  { feature: 'Enclosure style', chengdu: 'Glass-walled rooms + outdoor yards', dujiangyan: 'Open-air hillside enclosures — no glass' },
  { feature: 'Transit from downtown', chengdu: '30 min via Metro Line 3', dujiangyan: '~1.5 h door-to-door via train + taxi' },
  { feature: 'Entrance fee', chengdu: 'CNY 55 (students ¥27)', dujiangyan: 'CNY 58 (students ¥29)' },
  { feature: 'Current status', chengdu: 'OPEN — normal operations', dujiangyan: 'CLOSED for renovation since Apr 2026' },
];

const monthTable = [
  { month: 'Jan', temp: '3–9°C', crowds: 'Very low', activity: 'Cool-weather pandas active', rating: '★★★' },
  { month: 'Feb', temp: '5–12°C', crowds: 'Low', activity: 'Crisp air, quiet parks', rating: '★★★' },
  { month: 'Mar', temp: '10–17°C', crowds: 'Moderate', activity: 'Spring flowers, pandas outdoors', rating: '★★★★★' },
  { month: 'Apr', temp: '15–23°C', crowds: 'Moderate', activity: 'Ideal weather', rating: '★★★★★' },
  { month: 'May', temp: '19–27°C', crowds: 'Busy', activity: 'Active mornings', rating: '★★★★' },
  { month: 'Jun', temp: '22–30°C', crowds: 'Moderate', activity: 'Hot, rainy — lazy pandas', rating: '★★★' },
  { month: 'Jul', temp: '24–33°C', crowds: 'Very busy', activity: 'Hot — go early', rating: '★★' },
  { month: 'Aug', temp: '23–32°C', crowds: 'Very busy', activity: 'Hot — baby pandas visible', rating: '★★★' },
  { month: 'Sep', temp: '19–27°C', crowds: 'Moderate', activity: 'Autumn begins, golden light', rating: '★★★★★' },
  { month: 'Oct', temp: '15–22°C', crowds: 'Busy', activity: 'Ginkgo trees turn gold', rating: '★★★★' },
  { month: 'Nov', temp: '10–16°C', crowds: 'Low', activity: 'Crisp and clear', rating: '★★★★★' },
  { month: 'Dec', temp: '4–10°C', crowds: 'Very low', activity: 'Gray skies, hotpot weather', rating: '★★★' },
];

const experiences = [
  { title: 'Tea House Culture', desc: 'The ritual that defines Chengdu: hours with a covered cup of jasmine tea at Heming Tea House — a tradition over 1,000 years old.' },
  { title: 'Face-Changing Opera (变脸)', desc: 'Bian lian performers whip colored silk masks across their faces in a split second at Shufeng Yayun.' },
  { title: 'Mahjong (麻将)', desc: 'Walk any Chengdu park and you\'ll hear the clatter of 136 tiles — the local "blood battle" variant is the fastest in China.' },
  { title: 'Nightlife & Bar Streets', desc: 'Jiuyanqiao for cocktail bars, Kehua Road for late-night barbecue.' },
];

const itineraries = [
  {
    label: '1 Day — The Essentials',
    highlights: ['Panda Base (arrive 8 AM)', 'People\'s Park & Heming Tea House', 'Kuanzhai Alley (lunch + explore)', 'Jinli Street at lantern-lighting (dusk)', 'Hotpot dinner — Shu Daxia or Xiaolongkan'],
    href: '/blog/chengdu-3-day-itinerary',
  },
  {
    label: '2 Days — Deep Dive',
    highlights: ['All of Day 1', 'Wenshu Monastery morning + vegetarian lunch', 'Wuhou Shrine afternoon', 'Sichuan Opera at Shufeng Yayun (evening)', 'Late-night street food near Kehua Road'],
    href: '/blog/chengdu-3-day-itinerary',
  },
  {
    label: '3 Days — Beyond the City',
    highlights: ['All of Days 1–2', 'Leshan Giant Buddha (day trip by train)', 'or Mount Qingcheng (nature + Taoism)', 'Dujiangyan Panda Base (if reopened)', 'Farewell hotpot or street-food crawl'],
    href: '/blog/chengdu-3-day-itinerary',
  },
];

const hiddenGems = [
  {
    name: 'Jinsha Site Museum',
    tag: '3,000-year history',
    desc: 'The gold Sunbird disc unearthed here in 2001 is now Chengdu\'s emblem. Walk above actual excavation pits.',
    tip: 'Line 7 Metro · ¥70',
    img: '/images/jinsha-museum.webp',
    alt: 'Gold Sunbird artifact and excavation pit at Jinsha Site Museum, Chengdu',
  },
  {
    name: 'Daci Temple',
    tag: '1,600-year-old sanctuary',
    desc: 'A working Buddhist temple behind Taikoo Li — incense, chanting monks, 200-year-old ginkgo trees.',
    tip: '5 min walk from Chunxi Road · Free',
    img: '/images/daci-temple.webp',
    alt: 'Ancient Daci Temple courtyard with incense smoke and ginkgo trees, Taikoo Li skyline visible behind',
  },
  {
    name: 'Zhongshuge Bookstore',
    tag: 'Mirror-ceiling wonder',
    desc: 'Voted one of the world\'s most beautiful bookstores — mirrored ceilings and arched book tunnels.',
    tip: 'Line 2 Yintai Center · Free',
    img: '/images/zhongshuge-bookstore.webp',
    alt: 'Zhongshuge Bookstore Chengdu with mirrored ceilings, spiral staircases, and arched bookshelf tunnels',
  },
  {
    name: 'Eastern Suburb Memory',
    tag: 'Industrial-chic art hub',
    desc: 'A Soviet-era factory reborn as Chengdu\'s creative quarter — street art and weekend vintage market.',
    tip: 'Line 8 Dongjiao Jiyi · Free',
    img: '/images/eastern-suburb-memory.webp',
    alt: 'Street art and converted factory buildings at Eastern Suburb Memory creative district, Chengdu',
  },
  {
    name: 'New Century Global Center',
    tag: 'World\'s largest building',
    desc: '1.76 million m² under one roof — indoor beach, wave pool, ice rink.',
    tip: 'Line 1 Jincheng Plaza · Free entry',
    img: '/images/global-center.webp',
    alt: 'New Century Global Center exterior — the world\'s largest building by floor area in Chengdu',
  },
  {
    name: 'Luhu Eco-City',
    tag: 'Lakeside art escape',
    desc: 'A 2,000-acre eco-development with floating galleries — the Chengdu most visitors miss.',
    tip: 'Line 1 Luhu · Half-day trip',
    img: '/images/luhu-eco-city.webp',
    alt: 'Luhu Eco-City lakeside boardwalks and A4 Art Museum floating gallery in Chengdu',
  },
];

const chengduVsChongqing = [
  { aspect: 'Vibe', chengdu: 'Laid-back, flat, green — tea houses and slow mornings.', chongqing: 'Vertical and fast — a cyberpunk river city of steep staircases.' },
  { aspect: 'Food style', chengdu: 'Refined and complex — birthplace of mapo tofu.', chongqing: 'Bolder and oilier — home of the spiciest hotpot.' },
  { aspect: 'Best known for', chengdu: 'Pandas, tea houses, UNESCO gastronomy.', chongqing: 'Mountain skyline, hotpot, Three Gorges cruises.' },
  { aspect: 'Getting around', chengdu: 'Flat, bikeable; Metro covers most areas.', chongqing: 'Hilly; expect steep walks between Metro stops.' },
  { aspect: 'Day trips', chengdu: 'Leshan Buddha, Mount Qingcheng, Dujiangyan.', chongqing: 'Dazu Rock Carvings, Wulong Karst, Yangtze cruises.' },
  { aspect: 'Transit between', chengdu: '1.5 h high-speed train (~¥150)', chongqing: '1.5 h high-speed train (~¥150)' },
];

const travelerReviews = [
  { quote: '"We arrived at 8 AM and were SO glad we did. By 10 AM the pandas were already napping and the crowds had tripled. The baby pandas in the nursery were the size of loaves of bread."', source: 'Reddit r/travel · 2026', theme: 'Arrive early for pandas' },
  { quote: '"I thought I knew spicy food until Chengdu humbled me. The mala numbing sensation is completely different from anything I\'ve had before. By day three, I was addicted."', source: 'TripAdvisor · 2026', theme: 'The spice is real' },
  { quote: '"People\'s Park was the unexpected highlight of our trip. We sat at Heming Tea House for three hours just watching locals dance, sing, and play mahjong. It felt like we stumbled into the real Chengdu."', source: 'Google Reviews · 2026', theme: 'People\'s Park surprises' },
  { quote: '"The language barrier is more real in Chengdu than Beijing or Shanghai. Download a translation app before you go — the camera translation feature saved us at restaurants daily."', source: 'Klook reviews · 2026', theme: 'Come prepared' },
];

const infoSources = [
  { name: 'UNESCO Creative Cities', detail: 'City of Gastronomy designation (2011) & data', url: 'https://www.unesco.org/en/creative-cities/chengdu' },
  { name: 'Wikipedia — Chengdu', detail: 'City history, population & geography reference', url: 'https://en.wikipedia.org/wiki/Chengdu' },
  { name: 'UNESCO World Heritage Centre', detail: 'Dujiangyan, Mount Qingcheng & panda sanctuary listings', url: 'https://whc.unesco.org/en/statesparties/cn' },
  { name: 'Sichuan Giant Panda Sanctuaries', detail: 'World Heritage listing of the panda habitat', url: 'https://whc.unesco.org/en/list/1213' },
];

const referenceQuote = {
  text: 'Chengdu is the capital city of the Chinese province of Sichuan. With a population of 20,937,757 at the 2020 census, it is the country\'s fourth most populous city and the only city with a population of over 20 million apart from provincial-level municipalities. It is traditionally the hub of Western China.',
  source: 'Wikipedia',
  cite: 'Chengdu — the free encyclopedia',
  url: 'https://en.wikipedia.org/wiki/Chengdu',
};

const photoSpots = [
  { name: 'Wuhou Shrine Red Wall Corridor', img: '/images/wuhou-red-wall.webp', alt: 'Curving vermilion wall corridor at Wuhou Shrine with bamboo shadows in late afternoon sunlight', desc: 'Vermilion corridor with bamboo shadows; best late afternoon on weekdays.', tip: 'Late afternoon · Weekdays' },
  { name: 'Jinli Street at Dusk', img: '/images/jinli-lanterns.webp', alt: 'Red lanterns glowing above Jinli Ancient Street at dusk with golden cobblestone lanes', desc: 'Lanterns glow over cobblestone lanes — shoot from the arched bridge.', tip: 'Sunset · Tripod' },
  { name: 'Anshun Bridge at Night', img: '/images/anshun-bridge-night.webp', alt: 'Anshun Bridge illuminated at night with reflection in the Jin River', desc: 'Illuminated bridge reflected in the Jin River.', tip: 'After 7 PM · Long exposure' },
  { name: 'Panda Base — Morning Feeding', img: '/images/panda-eating.webp', alt: 'Giant panda eating bamboo in soft morning light at Chengdu Panda Base', desc: 'Pandas eating bamboo in morning light, no glass between you and them.', tip: '8:00–9:30 AM · 200mm+' },
];

const firstTimerMistakes = [
  { mistake: 'Arriving at the Panda Base at 11 AM', fix: 'Pandas nap by 11:30. Arrive at 7:45 AM to queue for the 8 AM opening.' },
  { mistake: 'Underestimating the spice', fix: 'Order one dish at a time — mala builds. Always have rice and a cold drink within reach.' },
  { mistake: 'Not having addresses in Chinese', fix: 'Save your hotel and key attractions in Chinese characters and show the screen to taxi drivers.' },
  { mistake: 'Skipping the VPN setup before arriving', fix: 'Install and test your VPN at home — you cannot download apps once inside China.' },
  { mistake: 'Trying to do too much in one day', fix: 'Two major activities per day is the sweet spot — mornings at the Panda Base, long lunches, afternoon tea houses.' },
  { mistake: 'Paying full price for everything', fix: 'Book on Trip.com or Meituan (10–20% cheaper). Didi beats taxis; book trains 1–2 days ahead.' },
];

const honestExpectations = [
  { title: 'The spice will humble you', desc: 'Sichuan mala isn\'t just heat — the peppercorns make your tongue tingle and go numb, unlike anything in Thai, Indian, or Mexican food. Non-spicy dishes exist, but half the menu bites back.' },
  { title: 'English is scarce outside hotels', desc: 'Menus rarely have English and taxi drivers won\'t understand you. Use a translation app with camera mode and carry your hotel address in Chinese.' },
  { title: 'Pandas nap through midday', desc: 'Pandas are most active 8:00–10:00 AM. By 11:30 most are asleep. Arrive at 1 PM expecting action and you\'ll be disappointed — set an early alarm.' },
  { title: 'Summer is punishing', desc: 'July–August brings 30°C+ heat, humidity, and domestic holidays. Spring (Mar–May) and autumn (Sep–Nov) are 15–25°C and far more pleasant.' },
];

const packingChecklist = [
  { item: 'Comfortable walking shoes', tag: 'MUST', desc: 'Temple complexes, ancient streets, and the Panda Base cover a lot of ground.' },
  { item: 'Umbrella or rain jacket', tag: 'MUST', desc: 'Chengdu gets sudden rain even in sunny seasons.' },
  { item: 'Translation app + offline Chinese pack', tag: 'MUST', desc: 'Camera translation is a lifesaver at picture-free menus.' },
  { item: 'Passport — always on you', tag: 'MUST', desc: 'Required for hotels, SIMs, train tickets, and ID checks.' },
  { item: 'VPN — installed and tested before leaving home', tag: 'MUST', desc: 'You cannot download VPN apps once inside China.' },
  { item: 'Portable battery pack (10,000+ mAh)', tag: 'SHOULD', desc: 'Your phone runs translation, maps, and payments all day.' },
  { item: 'Tissues and hand sanitizer', tag: 'SHOULD', desc: 'Many public restrooms lack toilet paper and soap.' },
  { item: 'An empty stomach and an open mind', tag: 'ENJOY', desc: 'Chengdu will feed you things you\'ve never tasted.' },
];

const faqs = [
  { q: 'What is the best time to visit Chengdu?', a: 'Spring (March–May) and autumn (September–November): 15–25°C and low rainfall. See the month-by-month table.' },
  { q: 'How many days do I need in Chengdu?', a: 'Two full days covers the essentials; add 1–2 days for a day trip.' },
  { q: 'What is Chengdu famous for?', a: 'Giant pandas, Sichuan cuisine (UNESCO City of Gastronomy since 2010), and tea-house culture over 1,000 years old.' },
  { q: 'Is Chengdu safe for tourists?', a: 'Yes — violent crime is extremely rare. Take normal precautions in crowds and at night.' },
  { q: 'Do I need a visa for Chengdu?', a: 'Most visitors need a tourist (L) visa; a 144-hour transit waiver covers 54 nationalities. Confirm with your embassy.' },
  { q: 'Which panda base should I visit?', a: 'Chengdu Research Base for most pandas (~200) and easy Metro access; Dujiangyan for quiet enclosures and volunteering.' },
  { q: 'Can I use credit cards in Chengdu?', a: 'Not widely. WeChat Pay and Alipay dominate (both accept foreign cards); carry cash for street stalls.' },
  { q: 'Is English widely spoken in Chengdu?', a: 'Limited outside hotels — use a translation app and keep addresses in Chinese characters.' },
  { q: 'How do I get from the airport to the city center?', a: 'Shuangliu (CTU): Metro Line 10, 20–30 min. Tianfu (TFU): Metro Line 18, 45–50 min.' },
];

const schema = {
  '@context': 'https://schema.org',
  'datePublished': '2026-07-29',
  'dateModified': '2026-08-05',
  '@graph': [
    {
      '@type': 'WebPage',
      name: 'Best of Chengdu 2026 — Complete Local Guide to Food, Attractions, Pandas & Travel Tips',
