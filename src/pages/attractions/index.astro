---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';

const items = [
  { label: 'Panda Base', href: '/attractions/panda-base/', tag: 'Nature', desc: 'The world-famous research base and the best place to see giant pandas up close.' },
  { label: 'Top Attractions', href: '/#attractions', tag: 'Must-See', desc: 'Jinli, Kuanzhai Alley, Wuhou Shrine — the essential sights every visitor should see.' },
  { label: 'Day Trips', href: '/attractions/day-trips/', tag: 'Nature', desc: 'From the Leshan Giant Buddha to Mount Qingcheng, the best escapes from the city.' },
];

const topSights = [
  { name: 'Chengdu Panda Base', rank: 'Unmissable', note: 'The single most popular attraction in the city. ~200 pandas, 30 min from downtown by Metro Line 3. Plan a half-day morning visit — pandas are active 8:00–10:00 AM.' },
  { name: 'Jinli Ancient Street', rank: 'Must-see', note: 'Lantern-lit streets, street food stalls, and traditional Sichuan crafts next to Wuhou Shrine. Best at dusk when the red lanterns light up.' },
  { name: 'Kuanzhai Alley', rank: 'Must-see', note: 'Three parallel Qing-dynasty alleys (Wide, Narrow, Well) filled with tea houses, boutiques, and courtyard restaurants. Free entry.' },
  { name: 'Wuhou Shrine', rank: 'Recommended', note: 'A serene temple complex dedicated to Zhuge Liang of Three Kingdoms fame, surrounded by ancient cypress trees. ¥50 entry.' },
  { name: 'People\'s Park', rank: 'Authentic', note: 'The living heart of Chengdu. Watch locals dance, sing, and drink covered-cup tea at Heming Tea House (est. 1923) by the lake. Free.' },
];

const faqs = [
  { q: 'How many days do I need for Chengdu\'s attractions?', a: 'Two days covers the essentials: one morning at the Panda Base plus the Jinli–Wuhou pairing, and a second day for Kuanzhai Alley, People\'s Park, and Daci Temple–Taikoo Li.' },
  { q: 'When should I visit the Panda Base?', a: 'Arrive by 8:00 AM. Pandas are most active 8:00–10:00 AM and nap through midday. See our full Panda Base guide for the step-by-step route.' },
  { q: 'Are Chengdu\'s attractions expensive?', a: 'Most are cheap or free. People\'s Park, Jinli, and Kuanzhai Alley are free; Wuhou Shrine is ¥50; the Panda Base is ¥55. A full sightseeing day rarely exceeds ¥110 per person.' },
  { q: 'Can I see Chengdu\'s sights without speaking Chinese?', a: 'Yes, but download a translation app — signage and menus are often Chinese-only. The Metro is bilingual and major sights have English ticket counters.' },
];

const infoSources = [
  { name: 'UNESCO World Heritage Centre', detail: 'Mount Qingcheng & Dujiangyan listing', url: 'https://whc.unesco.org/en/list/1001' },
  { name: 'Sichuan Giant Panda Sanctuaries', detail: 'World Heritage panda habitat listing', url: 'https://whc.unesco.org/en/list/1213' },
  { name: 'Wikipedia — Mount Qingcheng', detail: 'Taoist mountain history', url: 'https://en.wikipedia.org/wiki/Mount_Qingcheng' },
  { name: 'Wikipedia — Chengdu', detail: 'City history & geography', url: 'https://en.wikipedia.org/wiki/Chengdu' },
];

const referenceQuote = {
  text: 'Mount Qingcheng is a sacred Taoist mountain in Dujiangyan, Chengdu, Sichuan, China. It is considered one of the birthplaces of Taoism and, together with the nearby Dujiangyan irrigation system, forms a UNESCO World Heritage Site.',
  source: 'Wikipedia',
  cite: 'Mount Qingcheng — the free encyclopedia',
  url: 'https://en.wikipedia.org/wiki/Mount_Qingcheng',
};

const schema = {
  '@context': 'https://schema.org',
  'datePublished': '2026-07-29',
  'dateModified': '2026-08-05',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Best Attractions in Chengdu',
      description: 'Plan your perfect Chengdu trip with our handpicked list of the best attractions. From giant pandas to ancient temples and vibrant night markets.',
      'url': 'https://www.best-of-chengdu.com/attractions/',
      datePublished: '2026-07-29',
      dateModified: '2026-08-05',
      author: { '@type': 'Person', 'name': 'Best of Chengdu Team', 'url': 'https://www.best-of-chengdu.com/about/' },
      publisher: { '@type': 'Organization', 'name': 'Best of Chengdu', 'url': 'https://www.best-of-chengdu.com/' },
    },
    {
      '@type': 'Organization',
      name: 'Best of Chengdu',
      url: 'https://www.best-of-chengdu.com/',
      sameAs: [
        'https://github.com/jiusongvip/best-of-chengdu',
        'https://en.wikipedia.org/wiki/Chengdu',
        'https://www.wikidata.org/wiki/Q49802',
      ],
    },
    {
      '@type': 'Person',
      name: 'Best of Chengdu Team',
      url: 'https://www.best-of-chengdu.com/about/',
      knowsAbout: ['Chengdu Attractions', 'Panda Conservation', 'China Travel'],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.best-of-chengdu.com/' },
        { '@type': 'ListItem', position: 2, 'name': 'Attractions', 'item': 'https://www.best-of-chengdu.com/attractions/' }
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    },
  ],
};
---

<BaseLayout schemaJson={JSON.stringify(schema)} title="Best Attractions in Chengdu" description="Plan your perfect Chengdu trip with our handpicked list of the best attractions. From giant pandas to ancient temples and vibrant night markets.">
  <Header />

  <main>
    <section class="max-w-[1200px] mx-auto px-6 pt-20 pb-10">
      <h1 class="text-4xl md:text-5xl font-display font-semibold tracking-tighter leading-[1.1] max-w-[14ch]">
        Best Attractions in Chengdu
      </h1>
      <p class="mt-4 text-xs font-medium tracking-widest uppercase text-gray-400">
        Published <time datetime="2026-07-29">July 29, 2026</time> · Updated <time datetime="2026-08-05">August 5, 2026</time> · <a href="/about/" class="text-accent hover:underline">Best of Chengdu Team</a>
      </p>
      <p class="mt-4 text-lg text-gray-500 max-w-[56ch]">From giant pandas to thousand-year-old temples, Chengdu has sights that stay with you long after you leave. Most cost under ¥55 — several are free.</p>
    </section>

    <section class="max-w-[1200px] mx-auto px-6 pb-24">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-8">Explore by category</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {items.map(item => (
          <a href={item.href} class="group flex flex-col p-6 rounded-2xl border border-border hover:border-accent/30 hover:shadow-sm transition-all duration-200">
            <span class="text-xs font-medium text-accent mb-2">{item.tag}</span>
            <h3 class="font-display font-semibold text-lg text-[#1a1a1a] group-hover:text-accent transition-colors">{item.label}</h3>
            <p class="text-sm text-gray-500 mt-2 leading-relaxed">{item.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="bg-surface py-24">
      <div class="max-w-[1200px] mx-auto px-6">
        <h2 class="text-3xl font-display font-semibold tracking-tight mb-4">Top sights ranked</h2>
        <p class="text-gray-500 text-lg max-w-[48ch] mb-10">From unmissable icons to local favorites. Pick what fits your trip.</p>
        <div class="space-y-3 max-w-[800px]">
          {topSights.map((sight, i) => (
            <div class="flex items-center gap-4 p-4 rounded-xl bg-white border border-border">
              <span class="shrink-0 w-8 h-8 rounded-full bg-accent text-white text-xs font-semibold flex items-center justify-center">{i + 1}</span>
              <div class="flex-1">
                <div class="flex items-center gap-2">
                  <span class="font-semibold text-[#1a1a1a] text-sm">{sight.name}</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-accent/10 text-accent font-medium">{sight.rank}</span>
                </div>
                <p class="text-xs text-gray-500 mt-0.5">{sight.note}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="max-w-[860px] mx-auto px-6 py-24">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-8">FAQ</h2>
      <div class="space-y-6">
        {faqs.map(faq => (
          <div>
            <h3 class="font-semibold text-[#1a1a1a] mb-1">{faq.q}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-surface py-16">
      <div class="max-w-[860px] mx-auto px-6">
        <h2 class="text-2xl font-display font-semibold tracking-tight mb-2">Sources & References</h2>
        <p class="text-gray-500 text-sm mb-8">Authoritative references behind the history and facts on this page.</p>
        <blockquote class="border-l-4 border-accent/40 pl-5 py-3 mb-8 text-sm text-gray-600 italic leading-relaxed bg-white rounded-r-lg">
          <p>{referenceQuote.text}</p>
          <footer class="mt-2 text-xs text-accent not-italic">— <cite><a href={referenceQuote.url} target="_blank" rel="noopener noreferrer" class="underline hover:no-underline">{referenceQuote.source}, {referenceQuote.cite}</a></cite></footer>
        </blockquote>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {infoSources.map((s) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="group p-3 rounded-lg border border-border bg-white text-center hover:border-accent/30 transition-colors">
              <span class="block text-xs font-semibold text-[#1a1a1a] group-hover:text-accent transition-colors">{s.name}</span>
              <span class="block text-[10px] text-gray-400 mt-0.5">{s.detail}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
