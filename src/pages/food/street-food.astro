---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';

const schema = {
  '@context': 'https://schema.org',
  'datePublished': '2026-07-29',
  'dateModified': '2026-07-29',
  '@graph': [{'@type': 'Article', 'headline': 'Best Street Food in Chengdu', 'description': 'Dan dan noodles, skewers, and snacks that fuel Chengdu streets.', 'url': 'https://best-of-chengdu.com/food/street-food', 'author': {'@type': 'Organization', 'name': 'Best of Chengdu'}}, {'@type': 'BreadcrumbList', 'itemListElement': [{'@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://best-of-chengdu.com/'}, {'@type': 'ListItem', 'position': 2, 'name': 'Food', 'item': 'https://best-of-chengdu.com/food'}, {'@type': 'ListItem', 'position': 3, 'name': 'Street Food', 'item': 'https://best-of-chengdu.com/food/street-food'}]}],
};
---

<BaseLayout schemaJson={JSON.stringify(schema)} title="Best Street Food in Chengdu" description="Dan dan noodles, skewers, and snacks that fuel Chengdu streets.">
  <Header />

  <main>
    <section class="max-w-[860px] mx-auto px-6 pt-20 pb-24">
      <h1 class="text-4xl md:text-5xl font-display font-semibold tracking-tighter leading-[1.1]">
        Best Street Food in Chengdu
      </h1>
      <p class="mt-4 text-lg text-gray-500 leading-relaxed">Chengdu's streets are a 24-hour feast. From breakfast buns to late-night skewers, here is where to find the best street food in the city.</p>
    </section>
    <section class="max-w-[860px] mx-auto px-6 pb-16">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">Must-try street foods</h2>
      <div class="space-y-4">
        <div class="p-5 rounded-xl border border-border flex gap-4"><span class="shrink-0 w-8 h-8 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">1</span><div><h3 class="font-display font-semibold text-[#1a1a1a]">Dan Dan Noodles</h3><p class="text-sm text-gray-500 mt-1">The iconic Chengdu street dish. Thin noodles in a fiery sesame-chili sauce with minced pork and preserved vegetables. A complete meal for under 15 RMB.</p></div></div>
        <div class="p-5 rounded-xl border border-border flex gap-4"><span class="shrink-0 w-8 h-8 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">2</span><div><h3 class="font-display font-semibold text-[#1a1a1a]">Chuan Chuan Xiang (Skewers)</h3><p class="text-sm text-gray-500 mt-1">Choose your skewers from a refrigerated display, hand them to the cook, and they arrive swimming in a pot of spicy broth. Pay by the stick.</p></div></div>
        <div class="p-5 rounded-xl border border-border flex gap-4"><span class="shrink-0 w-8 h-8 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">3</span><div><h3 class="font-display font-semibold text-[#1a1a1a]">Guo Kui (Stuffed Flatbread)</h3><p class="text-sm text-gray-500 mt-1">Crispy baked flatbread stuffed with spiced pork or beef. The Chengdu answer to a sandwich. Look for the clay ovens on street corners.</p></div></div>
        <div class="p-5 rounded-xl border border-border flex gap-4"><span class="shrink-0 w-8 h-8 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">4</span><div><h3 class="font-display font-semibold text-[#1a1a1a]">Long Chao Shou (Wontons)</h3><p class="text-sm text-gray-500 mt-1">Silky wontons in chili oil, the Chengdu style. Smaller and more delicate than the Cantonese version, swimming in a pool of red oil and black vinegar.</p></div></div>
        <div class="p-5 rounded-xl border border-border flex gap-4"><span class="shrink-0 w-8 h-8 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">5</span><div><h3 class="font-display font-semibold text-[#1a1a1a]">Bingfen (Ice Jelly)</h3><p class="text-sm text-gray-500 mt-1">A cooling dessert made from ice jelly seeds, topped with brown sugar syrup, peanuts, and dried fruit. The perfect antidote to a spicy meal.</p></div></div>
    </section>
    <section class="bg-surface py-20">
      <div class="max-w-[860px] mx-auto px-6">
        <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">Best street food streets</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-xl bg-white border border-border"><h3 class="font-semibold text-[#1a1a1a]">Jianshe Road</h3><p class="text-sm text-gray-500 mt-1">The undisputed king of Chengdu street food. A long strip of stalls selling everything from grilled squid to durian pizza. University district, so prices stay low.</p></div>
          <div class="p-5 rounded-xl bg-white border border-border"><h3 class="font-semibold text-[#1a1a1a]">Yulin Night Market</h3><p class="text-sm text-gray-500 mt-1">A more local alternative to Jinli. Fewer tourists, more authentic snacks. Try the grilled brain flower if you are feeling adventurous.</p></div>
          <div class="p-5 rounded-xl bg-white border border-border"><h3 class="font-semibold text-[#1a1a1a]">Jinli Snack Street</h3><p class="text-sm text-gray-500 mt-1">Touristy but worth it for the atmosphere. Pick up a few skewers and walk through the lantern-lit ancient alley. Best at dusk.</p></div>
          <div class="p-5 rounded-xl bg-white border border-border"><h3 class="font-semibold text-[#1a1a1a]">Xiangxiang Lane</h3><p class="text-sm text-gray-500 mt-1">A narrow lane near Taikoo Li packed with tiny food stalls. Great for a quick bite between shopping stops.</p></div>
        </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
