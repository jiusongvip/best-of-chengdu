---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';

const subcategories = [
  { label: 'Hotpot', href: '/food/hotpot', desc: 'The fiery heart of Chengdu dining. Find the city\'s best bubbling broths.' },
  { label: 'Sichuan Restaurants', href: '/food/sichuan-restaurants', desc: 'Restaurants that define Sichuan cuisine, from fine dining to family-run legends.' },
];

const mustTry = [
  { dish: 'Mapo Tofu', desc: 'Silky tofu in a numbing, fiery sauce. The benchmark dish for any Sichuan chef.' },
  { dish: 'Kung Pao Chicken', desc: 'Tender chicken with peanuts and dried chilies. The real deal, not the takeout version.' },
  { dish: 'Dan Dan Noodles', desc: 'A humble street food elevated to art. Sesame paste, chili oil, and minced pork.' },
  { dish: 'Twice-Cooked Pork', desc: 'Pork belly simmered then wok-fried with fermented black beans and leeks.' },
  { dish: 'Hotpot', desc: 'A communal feast of bubbling broth, fresh ingredients, and good company.' },
  { dish: 'Fuqi Feipian', desc: 'Sliced beef and offal in a chili and Sichuan pepper dressing. Surprisingly addictive.' },
];

const schema = {
  '@context': 'https://schema.org',
  'datePublished': '2026-07-29',
  'dateModified': '2026-07-29',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Best Food in Chengdu',
      description: 'From fiery hotpot to delicate street snacks, explore the best food in Chengdu with our curated guide to iconic dishes, top restaurants, and local favorites.',
      'url': 'https://www.best-of-chengdu.com/food',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.best-of-chengdu.com/' },
        { '@type': 'ListItem', position: 2, 'name': 'Food', 'item': 'https://www.best-of-chengdu.com/food' }
      ],
    },
  ],
};
---

<BaseLayout schemaJson={JSON.stringify(schema)} title="Best Food in Chengdu" description="From fiery hotpot to delicate street snacks, explore the best food in Chengdu with our curated guide to iconic dishes, top restaurants, and local favorites.">
  <Header />

  <main>
    <section class="max-w-[1200px] mx-auto px-6 pt-20 pb-10">
      <h1 class="text-4xl md:text-5xl font-display font-semibold tracking-tighter leading-[1.1] max-w-[14ch]">
        Best Food in Chengdu
      </h1>
      <p class="mt-4 text-lg text-gray-500 max-w-[56ch]">Chengdu is a UNESCO City of Gastronomy for good reason. From fiery hotpot to delicate snacks, here is what to eat and where to find it.</p>
    </section>

    <section class="max-w-[1200px] mx-auto px-6 pb-24">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-8">Explore by category</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {subcategories.map(sub => (
          <a href={sub.href} class="group flex flex-col p-6 rounded-2xl border border-border hover:border-accent/30 hover:shadow-sm transition-all duration-200">
            <h3 class="font-display font-semibold text-lg text-[#1a1a1a] group-hover:text-accent transition-colors">{sub.label}</h3>
            <p class="text-sm text-gray-500 mt-2 leading-relaxed">{sub.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="bg-surface py-24">
      <div class="max-w-[1200px] mx-auto px-6">
        <h2 class="text-3xl font-display font-semibold tracking-tight mb-4">Must-try dishes</h2>
        <p class="text-gray-500 text-lg max-w-[48ch] mb-10">The classics that define Sichuan cuisine. Each one is a reason to visit Chengdu.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {mustTry.map(item => (
            <div class="p-5 rounded-xl bg-white border border-border">
              <h3 class="font-display font-semibold text-base text-[#1a1a1a]">{item.dish}</h3>
              <p class="text-sm text-gray-500 mt-1.5 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
    </section>

    <section class="max-w-[1200px] mx-auto px-6 py-24">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-8">FAQ</h2>
      <div class="space-y-6 max-w-[72ch]">
        <div>
          <h3 class="font-semibold text-[#1a1a1a] mb-1">What is the spiciest food in Chengdu?</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Hotpot with extra mala (numbing-spicy) broth is the king of heat. For a pure chili burn, try a dry pot (gan guo) dish.</p>
        </div>
        <div>
          <h3 class="font-semibold text-[#1a1a1a] mb-1">Can vegetarians eat well in Chengdu?</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Yes. Many Buddhist vegetarian restaurants serve excellent meat-free Sichuan food. Mapo tofu (without pork), eggplant dishes, and vegetable hotpot are widely available.</p>
        </div>
        <div>
          <h3 class="font-semibold text-[#1a1a1a] mb-1">What is a typical food budget?</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Street food meals start at 10-20 RMB. Mid-range restaurant meals run 50-80 RMB per person. High-end hotpot or banquet dining can reach 150-300 RMB per person.</p>
        </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
