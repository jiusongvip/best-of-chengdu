---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';

const schema = {
  '@context': 'https://schema.org',
  'datePublished': '2026-07-29',
  'dateModified': '2026-07-29',
  '@graph': [{'@type': 'Article', 'headline': 'Best Tea Houses in Chengdu', 'description': 'Traditional tea houses and the centuries-old ritual of Chengdu tea culture.', 'url': 'https://best-of-chengdu.com/food/tea-houses', 'author': {'@type': 'Organization', 'name': 'Best of Chengdu'}}, {'@type': 'BreadcrumbList', 'itemListElement': [{'@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://best-of-chengdu.com/'}, {'@type': 'ListItem', 'position': 2, 'name': 'Food', 'item': 'https://best-of-chengdu.com/food'}, {'@type': 'ListItem', 'position': 3, 'name': 'Tea Houses', 'item': 'https://best-of-chengdu.com/food/tea-houses'}]}],
};
---

<BaseLayout schemaJson={JSON.stringify(schema)} title="Best Tea Houses in Chengdu" description="Traditional tea houses and the centuries-old ritual of Chengdu tea culture.">
  <Header />

  <main>
    <section class="max-w-[860px] mx-auto px-6 pt-20 pb-24">
      <h1 class="text-4xl md:text-5xl font-display font-semibold tracking-tighter leading-[1.1]">
        Best Tea Houses in Chengdu
      </h1>
      <p class="mt-4 text-lg text-gray-500 leading-relaxed">The tea house is the living room of Chengdu. It is where deals are made, friendships are forged, and afternoons dissolve into evening over endless refills of jasmine tea.</p>
    </section>
    <section class="max-w-[860px] mx-auto px-6 pb-16">
      <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">The best tea houses in Chengdu</h2>
      <div class="space-y-4">
        <div class="p-5 rounded-xl border border-border flex gap-4"><span class="shrink-0 w-8 h-8 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">1</span><div><div class="flex items-center gap-2"><h3 class="font-display font-semibold text-[#1a1a1a]">Heming Tea House</h3><span class="text-xs px-2 py-0.5 rounded-full bg-surface text-gray-500">People's Park</span></div><p class="text-sm text-gray-500 mt-1">The most famous tea house in Chengdu, inside People's Park. Sit by the lake under willow trees, order a cup of jasmine tea, and let the ear-cleaners and card players provide the entertainment.</p></div></div>
        <div class="p-5 rounded-xl border border-border flex gap-4"><span class="shrink-0 w-8 h-8 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">2</span><div><div class="flex items-center gap-2"><h3 class="font-display font-semibold text-[#1a1a1a]">Shufeng Yayun</h3><span class="text-xs px-2 py-0.5 rounded-full bg-surface text-gray-500">Culture Park</span></div><p class="text-sm text-gray-500 mt-1">More than a tea house, this is a Sichuan opera theater where you can drink tea while watching face-changing performances. A perfect introduction to both traditions.</p></div></div>
        <div class="p-5 rounded-xl border border-border flex gap-4"><span class="shrink-0 w-8 h-8 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">3</span><div><div class="flex items-center gap-2"><h3 class="font-display font-semibold text-[#1a1a1a]">Daci Temple Tea House</h3><span class="text-xs px-2 py-0.5 rounded-full bg-surface text-gray-500">Taikoo Li area</span></div><p class="text-sm text-gray-500 mt-1">A serene Buddhist temple with a tea house tucked inside. The contrast between the ancient courtyard and the surrounding modern shopping district is pure Chengdu.</p></div></div>
        <div class="p-5 rounded-xl border border-border flex gap-4"><span class="shrink-0 w-8 h-8 rounded-full bg-accent/10 text-accent text-xs font-semibold flex items-center justify-center">4</span><div><div class="flex items-center gap-2"><h3 class="font-display font-semibold text-[#1a1a1a]">Chenjin Teahouse</h3><span class="text-xs px-2 py-0.5 rounded-full bg-surface text-gray-500">Kuanzhai Alley</span></div><p class="text-sm text-gray-500 mt-1">An elegant spot inside Kuanzhai Alley serving premium teas in a beautifully restored Qing-dynasty courtyard. Slightly pricier but worth it for the setting.</p></div></div>
    </section>
    <section class="bg-surface py-20">
      <div class="max-w-[860px] mx-auto px-6">
        <h2 class="text-2xl font-display font-semibold tracking-tight mb-6">Tea house etiquette</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-xl bg-white border border-border"><h3 class="font-semibold text-[#1a1a1a]">Tapping the table</h3><p class="text-sm text-gray-500 mt-1">When someone pours tea for you, tap two fingers on the table as a silent thank you. This tradition dates back to the Qing dynasty.</p></div>
          <div class="p-5 rounded-xl bg-white border border-border"><h3 class="font-semibold text-[#1a1a1a]">Refills are free</h3><p class="text-sm text-gray-500 mt-1">Most tea houses provide unlimited hot water refills. One cup of tea can last you an entire afternoon. No one will rush you to leave.</p></div>
          <div class="p-5 rounded-xl bg-white border border-border"><h3 class="font-semibold text-[#1a1a1a]">Cost</h3><p class="text-sm text-gray-500 mt-1">Basic tea at a park tea house is 10-30 RMB. Premium tea houses charge 50-100 RMB per person. At Heming, you pay for the tea, not the seat.</p></div>
          <div class="p-5 rounded-xl bg-white border border-border"><h3 class="font-semibold text-[#1a1a1a]">Best time to go</h3><p class="text-sm text-gray-500 mt-1">Weekday afternoons are quiet and perfect for reading. Weekends are lively with locals playing cards and mahjong. Both are Chengdu experiences.</p></div>
        </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
