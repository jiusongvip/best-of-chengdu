---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';

const posts = [
  {
    title: 'Chengdu 3-Day Itinerary: The Perfect First Visit',
    href: '/blog/chengdu-3-day-itinerary',
    desc: 'A carefully paced three-day plan that hits the pandas, the food, the ancient streets, and the hidden corners most tourists miss.',
    date: 'July 28, 2026',
    tag: 'Itineraries',
  },
  {
    title: 'Chengdu Food Guide for First-Timers: What to Eat & How to Order',
    href: '/blog/chengdu-food-guide-first-timers',
    desc: 'Your survival guide to Sichuan cuisine. Dish-by-dish breakdown, how to order without speaking Chinese, and what to avoid.',
    date: 'July 15, 2026',
    tag: 'Food',
  },
];

const schema = {
  '@context': 'https://schema.org',
  'datePublished': '2026-07-29',
  'dateModified': '2026-07-29',
  '@graph': [
    {
      '@type': 'CollectionPage',
      'name': 'Chengdu Travel Blog — Tips, Guides & Local Insights',
      'description': 'In-depth Chengdu travel guides, itineraries, and local tips from the Best of Chengdu team.',
      'url': 'https://best-of-chengdu.com/blog'
    },
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://best-of-chengdu.com/' },
        { '@type': 'ListItem', 'position': 2, 'name': 'Blog', 'item': 'https://best-of-chengdu.com/blog' },
      ],
    },
  ],
};
---

<BaseLayout schemaJson={JSON.stringify(schema)} title="Chengdu Travel Blog" description="In-depth Chengdu travel guides, 3-day itineraries, hidden gem recommendations, and local food tips from the Best of Chengdu team. Updated regularly with fresh insights.">
  <Header />

  <main>
    <section class="max-w-[860px] mx-auto px-6 pt-20 pb-10">
      <h1 class="text-4xl md:text-5xl font-display font-semibold tracking-tighter leading-[1.1]">
        Chengdu Travel Blog
      </h1>
      <p class="mt-4 text-lg text-gray-500 max-w-[56ch]">In-depth guides, local tips, and stories from the team behind Best of Chengdu. Updated regularly.</p>
    </section>

    <section class="max-w-[860px] mx-auto px-6 pb-24">
      <div class="space-y-6">
        {posts.map((post) => (
          <a href={post.href} class="group block p-6 rounded-2xl border border-border hover:border-accent/30 hover:shadow-sm transition-all duration-200">
            <div class="flex items-center gap-3 mb-2">
              <span class="text-xs px-2 py-0.5 rounded-full bg-accent/10 text-accent font-medium">{post.tag}</span>
              <span class="text-xs text-gray-400">{post.date}</span>
            </div>
            <h2 class="font-display font-semibold text-xl text-[#1a1a1a] group-hover:text-accent transition-colors">{post.title}</h2>
            <p class="text-sm text-gray-500 mt-2 leading-relaxed">{post.desc}</p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
